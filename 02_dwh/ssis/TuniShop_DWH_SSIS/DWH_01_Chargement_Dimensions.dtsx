          SQLTask:Connection="{CD762A3B-8D10-4039-8233-E6EAE33779C7}"
          SQLTask:SqlStatementSource="DECLARE @p INT = ?;&#xA;SELECT COALESCE(NULLIF(@p, 0), (SELECT MAX(id_chargement) FROM audit.execution_lot)) AS id_chargement;"
