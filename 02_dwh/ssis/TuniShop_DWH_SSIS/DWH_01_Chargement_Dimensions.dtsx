            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Package::IdChargement"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
