0</FormatString></Measure><Measure><ID>Nb Livrees A Temps</ID><Name>Nb Livrees A Temps</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_livraisons</TableID><ColumnID>nb_livrees_a_temps</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Nb Livrees En Retard</ID><Name>Nb Livrees En Retard</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_livraisons</TableID><ColumnID>nb_livrees_en_retard</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Nb Livrees 1er Passage</ID><Name>Nb Livrees 1er Passage</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_livraisons</TableID><ColumnID>nb_livrees_1er_passage</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Somme Delai Livraison J</ID><Name>Somme Delai Livraison J</Name><AggregateFunction>Sum</AggregateFunction><DataType>Double</DataType><Source><DataType>Double</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_livraisons</TableID><ColumnID>delai_livraison_j</ColumnID></Source></Source><FormatString>#,##0.00</FormatString></Measure><Measure><ID>Somme Retard J</ID><Name>Somme Retard J</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_livraisons</TableID><ColumnID>retard_j</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Cout Transport HT</ID><Name>Cout Transport HT</Name><AggregateFunction>Sum</AggregateFunction><DataType>Double</DataType><Source><DataType>Double</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_livraisons</TableID><ColumnID>cout_transport_ht</ColumnID></Source></Source><FormatString>#,##0.000</FormatString></Measure><Measure><ID>Poids Kg</ID><Name>Poids Kg</Name><AggregateFunction>Sum</AggregateFunction><DataType>Double</DataType><Source><DataType>Double</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_livraisons</TableID><ColumnID>poids_kg</ColumnID></Source></Source><FormatString>#,##0.00</FormatString></Measure></Measures><StorageMode>Molap</StorageMode><ProcessingMode>Regular</ProcessingMode><Dimensions><Dimension xsi:type="RegularMeasureGroupDimension"><CubeDimensionID>Date</CubeDimensionID><Attributes><Attribute><AttributeID>Jour</AttributeID><KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_livraisons</TableID><ColumnID>date_expedition_sk</ColumnID></Source></KeyColumn></KeyColumns><Type>Granularity</Type></Attribute></Attributes></Dimension><Dimension xsi:type="RegularMeasureGroupDimension"><CubeDimensionID>Geographie</CubeDimensionID><Attributes><Attribute><AttributeID>Gouvernorat</AttributeID><KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_livraisons</TableID><ColumnID>geographie_sk</ColumnID></Source></KeyColumn></KeyColumns><Type>Granularity</Type></Attribute></Attributes></Dimension><Dimension xsi:type="RegularMeasureGroupDimension"><CubeDimensionID>Entrepot</CubeDimensionID><Attributes><Attribute><AttributeID>Entrepot</AttributeID><KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_livraisons</TableID><ColumnID>entrepot_sk</ColumnID></Source></KeyColumn></KeyColumns><Type>Granularity</Type></Attribute></Attributes></Dimension></Dimensions><Partitions><Partition><ID>Direction_Livraisons</ID><Name>Direction_Livraisons</Name><Source xsi:type="DsvTableBinding"><DataSourceViewID>TuniShop</DataSourceViewID><TableID>olap_v_fact_livraisons</TableID></Source><StorageMode>Molap</StorageMode><ProcessingMode>Regular</ProcessingMode></Partition></Partitions></MeasureGroup><MeasureGroup><ID>Avis</ID><Name>Avis</Name><Measures><Measure><ID>Nb Avis</ID><Name>Nb Avis</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_avis</TableID><ColumnID>nb_avis</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Nb Avis Notes</ID><Name>Nb Avis Notes</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_avis</TableID><ColumnID>nb_avis_notes</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Nb Avis Negatifs</ID><Name>Nb Avis Negatifs</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_avis</TableID><ColumnID>nb_avis_negatifs</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Somme Notes</ID><Name>Somme Notes</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_avis</TableID><ColumnID>note</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure></Measures><StorageMode>Molap</StorageMode><ProcessingMode>Regular</ProcessingMode><Dimensions><Dimension xsi:type="RegularMeasureGroupDimension"><CubeDimensionID>Date</CubeDimensionID><Attributes><Attribute><AttributeID>Jour</AttributeID><KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_avis</TableID><ColumnID>date_avis_sk</ColumnID></Source></KeyColumn></KeyColumns><Type>Granularity</Type></Attribute></Attributes></Dimension><Dimension xsi:type="RegularMeasureGroupDimension"><CubeDimensionID>Produit</CubeDimensionID><Attributes><Attribute><AttributeID>Produit</AttributeID><KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_avis</TableID><ColumnID>produit_sk</ColumnID></Source></KeyColumn></KeyColumns><Type>Granularity</Type></Attribute></Attributes></Dimension></Dimensions><Partitions><Partition><ID>Direction_Avis</ID><Name>Direction_Avis</Name><Source xsi:type="DsvTableBinding"><DataSourceViewID>TuniShop</DataSourceViewID><TableID>olap_v_fact_avis</TableID></Source><StorageMode>Molap</StorageMode><ProcessingMode>Regular</ProcessingMode></Partition></Partitions></MeasureGroup><MeasureGroup><ID>Marketing</ID><Name>Marketing</Name><Measures><Measure><ID>Depense HT</ID><Name>Depense HT</Name><AggregateFunction>Sum</AggregateFunction><DataType>Double</DataType><Source><DataType>Double</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_marketing_quotidien</TableID><ColumnID>depense_ht</ColumnID></Source></Source><FormatString>#,##0.000</FormatString></Measure><Measure><ID>Impressions</ID><Name>Impressions</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_marketing_quotidien</TableID><ColumnID>impressions</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Clics</ID><Name>Clics</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_marketing_quotidien</TableID><ColumnID>clics</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Commandes Attribuees</ID><Name>Commandes Attribuees</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_marketing_quotidien</TableID><ColumnID>commandes_attribuees</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Nouveaux Clients Attribues</ID><Name>Nouveaux Clients Attribues</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_marketing_quotidien</TableID><ColumnID>nouveaux_clients_attribues</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>CA Attribue TTC</ID><Name>CA Attribue TTC</Name><AggregateFunction>Sum</AggregateFunction><DataType>Double</DataType><Source><DataType>Double</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_marketing_quotidien</TableID><ColumnID>ca_attribue_ttc</ColumnID></Source></Source><FormatString>#,##0.000</FormatString></Measure></Measures><StorageMode>Molap</StorageMode><ProcessingMode>Regular</ProcessingMode><Dimensions><Dimension xsi:type="RegularMeasureGroupDimension"><CubeDimensionID>Date</CubeDimensionID><Attributes><Attribute><AttributeID>Jour</AttributeID><KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_marketing_quotidien</TableID><ColumnID>date_sk</ColumnID></Source></KeyColumn></KeyColumns><Type>Granularity</Type></Attribute></Attributes></Dimension></Dimensions><Partitions><Partition><ID>Direction_Marketing</ID><Name>Direction_Marketing</Name><Source xsi:type="DsvTableBinding"><DataSourceViewID>TuniShop</DataSourceViewID><TableID>olap_v_fact_marketing_quotidien</TableID></Source><StorageMode>Molap</StorageMode><ProcessingMode>Regular</ProcessingMode></Partition></Partitions></MeasureGroup></MeasureGroups><Source><DataSourceViewID>TuniShop</DataSourceViewID></Source><MdxScripts><MdxScript><ID>MdxScript</ID><Name>MdxScript</Name><Commands><Command><Text>/* =====================================================================
   11f_Calculs_Cube_Direction.mdx — TuniShop — script de calcul du cube [Direction]
   ---------------------------------------------------------------------
   Cube 6 — Direction : synthèse des 5 domaines pour le tableau de bord de direction.
   12 KPI de pilotage (v1) recopiés À L'IDENTIQUE des scripts 11a à 11e (mêmes noms,
   mêmes formules) : un KPI affiché dans le cube Direction doit donner exactement
   la même valeur que dans son cube métier (contrôle : 12f_Recette_Cube_Direction.mdx).
   Déjà intégré dans Direction.cube (onglet « Calculs »). Ce fichier sert de référence.
   Groupes de mesures : Ventes, Commandes (cube Ventes) · Clients distincts, Marketing
   (cube Marketing Clients) · Stock mensuel (cube Stock) · Achats (cube Achats) ·
   Livraisons, Avis (cube Livraisons).
   Divisions protégées (NULL si dénominateur vide).
   ===================================================================== */
CALCULATE;

/* ---------- 1. Ventes (source : 11a) ---------- */
CREATE MEMBER CURRENTCUBE.[Measures].[CA Reconnu TTC] AS
    ([Measures].[Montant Total TTC], [Statut Commande].[Famille Statut].&amp;[aboutie]),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI Direction\1 Ventes', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Commandes Reconnues] AS
    ([Measures].[Nb Commandes], [Statut Commande].[Famille Statut].&amp;[aboutie]),
    FORMAT_STRING = "#,##0", DISPLAY_FOLDER = 'KPI Direction\1 Ventes', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[CA HT Reconnu] AS
    ([Measures].[Montant Ligne HT], [Statut Commande].[Famille Statut].&amp;[aboutie]),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI Direction\1 Ventes', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Marge Brute Reconnue HT] AS
    ([Measures].[Marge Brute HT], [Statut Commande].[Famille Statut].&amp;[aboutie]),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI Direction\1 Ventes', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Taux Marge Brute] AS
    IIF([Measures].[CA HT Reconnu] = 0, NULL, [Measures].[Marge Brute Reconnue HT] / [Measures].[CA HT Reconnu]),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI Direction\1 Ventes', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Panier Moyen TTC] AS
    IIF([Measures].[Commandes Reconnues] = 0, NULL, [Measures].[CA Reconnu TTC] / [Measures].[Commandes Reconnues]),
    FORMAT_STRING = "#,##0.00", DISPLAY_FOLDER = 'KPI Direction\1 Ventes', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[CA Reconnu A-1] AS
    ([Measures].[CA Reconnu TTC],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI Direction\1 Ventes', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Evolution CA Reconnu] AS
    IIF(IsEmpty([Measures].[CA Reconnu TTC]) OR IsEmpty([Measures].[CA Reconnu A-1]) OR [Measures].[CA Reconnu A-1] = 0, NULL,
        ([Measures].[CA Reconnu TTC] - [Measures].[CA Reconnu A-1]) / [Measures].[CA Reconnu A-1]),
    FORMAT_STRING = "0.0%", DISPLAY_FOLDER = 'KPI Direction\1 Ventes', VISIBLE = 1;

/* ---------- 2. Clients (source : 11e) ---------- */
-- Clients actifs = clients distincts, hors commandes en échec de paiement
CREATE MEMBER CURRENTCUBE.[Measures].[Clients Actifs] AS
    Aggregate(
        Except([Statut Commande].[Statut].[Statut].MEMBERS, { [Statut Commande].[Statut].&amp;[paiement_echoue] }),
        [Measures].[Nb Clients]),
    FORMAT_STRING = "#,##0", DISPLAY_FOLDER = 'KPI Direction\2 Clients', VISIBLE = 1;

/* ---------- 3. Stock (source : 11b ; Valeur Stock HT = mesure de base LastNonEmpty) ---------- */
CREATE MEMBER CURRENTCUBE.[Measures].[Taux Rupture Stock] AS
    IIF([Measures].[Nb Inventaires] = 0, NULL, [Measures].[Nb Ruptures] / [Measures].[Nb Inventaires]),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI Direction\3 Stock', VISIBLE = 1;

/* ---------- 4. Achats (source : 11c ; Montant Achat HT = mesure de base) ---------- */
CREATE MEMBER CURRENTCUBE.[Measures].[Taux Service Fournisseur] AS
    IIF([Measures].[Quantite Commandee Recue] = 0, NULL, [Measures].[Quantite Recue] / [Measures].[Quantite Commandee Recue]),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI Direction\4 Achats', VISIBLE = 1;

/* ---------- 5. Livraisons et satisfaction (source : 11d) ---------- */
CREATE MEMBER CURRENTCUBE.[Measures].[OTD] AS
    IIF([Measures].[Nb Livrees] = 0, NULL, [Measures].[Nb Livrees A Temps] / [Measures].[Nb Livrees]),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI Direction\5 Livraisons', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Note Moyenne] AS
    IIF([Measures].[Nb Avis Notes] = 0, NULL, [Measures].[Somme Notes] / [Measures].[Nb Avis Notes]),
    FORMAT_STRING = "0.000", DISPLAY_FOLDER = 'KPI Direction\5 Livraisons', VISIBLE = 1;

/* ---------- 6. Marketing (source : 11e) ---------- */
CREATE MEMBER CURRENTCUBE.[Measures].[ROAS] AS
    IIF([Measures].[Depense HT] = 0, NULL, [Measures].[CA Attribue TTC] / [Measures].[Depense HT]),
    FORMAT_STRING = "0.000", DISPLAY_FOLDER = 'KPI Direction\6 Marketing', VISIBLE = 1;

/* =====================================================================
   v2 (29/10/2026) — comparaison à l'année précédente et feux de tendance
   A-1      : même KPI sur la période parallèle de l'année précédente (hiérarchie Calendrier).
   Evolution : variation relative (montants, nombres, panier, note, ROAS).
   Ecart     : différence en points de pourcentage (taux).
   Statut    : 1 = favorable, 0 = stable, -1 = défavorable, NULL sans année précédente.
               Stable : |évolution| &lt; 2 % ou |écart| &lt; 0,5 point. Pas de statut pour la valeur
               du stock et le montant des achats (une hausse n'est ni bonne ni mauvaise en soi).
   Couleur   : #1E7B4F (vert, favorable), #5B6B7C (gris, stable ou sans comparaison), #B42318 (rouge).
   Aucun objectif chiffré : les feux comparent à l'année précédente, pas à une cible.
   ===================================================================== */

/* ---------- 7. Année précédente ---------- */
CREATE MEMBER CURRENTCUBE.[Measures].[Taux Marge Brute A-1] AS
    ([Measures].[Taux Marge Brute],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI Direction\7 Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Panier Moyen TTC A-1] AS
    ([Measures].[Panier Moyen TTC],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "#,##0.00", DISPLAY_FOLDER = 'KPI Direction\7 Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Clients Actifs A-1] AS
    ([Measures].[Clients Actifs],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "#,##0", DISPLAY_FOLDER = 'KPI Direction\7 Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Valeur Stock HT A-1] AS
    ([Measures].[Valeur Stock HT],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI Direction\7 Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Taux Rupture Stock A-1] AS
    ([Measures].[Taux Rupture Stock],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI Direction\7 Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Montant Achat HT A-1] AS
    ([Measures].[Montant Achat HT],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI Direction\7 Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Taux Service Fournisseur A-1] AS
    ([Measures].[Taux Service Fournisseur],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI Direction\7 Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[OTD A-1] AS
    ([Measures].[OTD],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI Direction\7 Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Note Moyenne A-1] AS
    ([Measures].[Note Moyenne],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "0.000", DISPLAY_FOLDER = 'KPI Direction\7 Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[ROAS A-1] AS
    ([Measures].[ROAS],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "0.000", DISPLAY_FOLDER = 'KPI Direction\7 Année précédente', VISIBLE = 1;

/* ---------- 8. Évolutions et écarts ---------- */
CREATE MEMBER CURRENTCUBE.[Measures].[Ecart Taux Marge Brute] AS
    IIF(IsEmpty([Measures].[Taux Marge Brute]) OR IsEmpty([Measures].[Taux Marge Brute A-1]), NULL,
        ([Measures].[Taux Marge Brute] - [Measures].[Taux Marge Brute A-1]) * 100),
    FORMAT_STRING = "+0.00;-0.00;0.00", DISPLAY_FOLDER = 'KPI Direction\8 Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Evolution Panier Moyen] AS
    IIF(IsEmpty([Measures].[Panier Moyen TTC]) OR IsEmpty([Measures].[Panier Moyen TTC A-1]) OR [Measures].[Panier Moyen TTC A-1] = 0, NULL,
        ([Measures].[Panier Moyen TTC] - [Measures].[Panier Moyen TTC A-1]) / [Measures].[Panier Moyen TTC A-1]),
    FORMAT_STRING = "+0.0%;-0.0%;0.0%", DISPLAY_FOLDER = 'KPI Direction\8 Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Evolution Clients Actifs] AS
    IIF(IsEmpty([Measures].[Clients Actifs]) OR IsEmpty([Measures].[Clients Actifs A-1]) OR [Measures].[Clients Actifs A-1] = 0, NULL,
        ([Measures].[Clients Actifs] - [Measures].[Clients Actifs A-1]) / [Measures].[Clients Actifs A-1]),
    FORMAT_STRING = "+0.0%;-0.0%;0.0%", DISPLAY_FOLDER = 'KPI Direction\8 Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Evolution Valeur Stock] AS
    IIF(IsEmpty([Measures].[Valeur Stock HT]) OR IsEmpty([Measures].[Valeur Stock HT A-1]) OR [Measures].[Valeur Stock HT A-1] = 0, NULL,
        ([Measures].[Valeur Stock HT] - [Measures].[Valeur Stock HT A-1]) / [Measures].[Valeur Stock HT A-1]),
    FORMAT_STRING = "+0.0%;-0.0%;0.0%", DISPLAY_FOLDER = 'KPI Direction\8 Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Ecart Taux Rupture Stock] AS
    IIF(IsEmpty([Measures].[Taux Rupture Stock]) OR IsEmpty([Measures].[Taux Rupture Stock A-1]), NULL,
        ([Measures].[Taux Rupture Stock] - [Measures].[Taux Rupture Stock A-1]) * 100),
    FORMAT_STRING = "+0.00;-0.00;0.00", DISPLAY_FOLDER = 'KPI Direction\8 Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Evolution Montant Achat] AS
    IIF(IsEmpty([Measures].[Montant Achat HT]) OR IsEmpty([Measures].[Montant Achat HT A-1]) OR [Measures].[Montant Achat HT A-1] = 0, NULL,
        ([Measures].[Montant Achat HT] - [Measures].[Montant Achat HT A-1]) / [Measures].[Montant Achat HT A-1]),
    FORMAT_STRING = "+0.0%;-0.0%;0.0%", DISPLAY_FOLDER = 'KPI Direction\8 Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Ecart Taux Service Fournisseur] AS
    IIF(IsEmpty([Measures].[Taux Service Fournisseur]) OR IsEmpty([Measures].[Taux Service Fournisseur A-1]), NULL,
        ([Measures].[Taux Service Fournisseur] - [Measures].[Taux Service Fournisseur A-1]) * 100),
    FORMAT_STRING = "+0.00;-0.00;0.00", DISPLAY_FOLDER = 'KPI Direction\8 Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Ecart OTD] AS
    IIF(IsEmpty([Measures].[OTD]) OR IsEmpty([Measures].[OTD A-1]), NULL,
        ([Measures].[OTD] - [Measures].[OTD A-1]) * 100),
    FORMAT_STRING = "+0.00;-0.00;0.00", DISPLAY_FOLDER = 'KPI Direction\8 Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Evolution Note Moyenne] AS
    IIF(IsEmpty([Measures].[Note Moyenne]) OR IsEmpty([Measures].[Note Moyenne A-1]) OR [Measures].[Note Moyenne A-1] = 0, NULL,
        ([Measures].[Note Moyenne] - [Measures].[Note Moyenne A-1]) / [Measures].[Note Moyenne A-1]),
    FORMAT_STRING = "+0.0%;-0.0%;0.0%", DISPLAY_FOLDER = 'KPI Direction\8 Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Evolution ROAS] AS
    IIF(IsEmpty([Measures].[ROAS]) OR IsEmpty([Measures].[ROAS A-1]) OR [Measures].[ROAS A-1] = 0, NULL,
        ([Measures].[ROAS] - [Measures].[ROAS A-1]) / [Measures].[ROAS A-1]),
    FORMAT_STRING = "+0.0%;-0.0%;0.0%", DISPLAY_FOLDER = 'KPI Direction\8 Evolutions', VISIBLE = 1;

/* ---------- 9. Feux de tendance ---------- */
CREATE MEMBER CURRENTCUBE.[Measures].[Statut CA Reconnu] AS
    IIF(IsEmpty([Measures].[Evolution CA Reconnu]), NULL,
        IIF([Measures].[Evolution CA Reconnu] &gt; 0.02, 1, IIF([Measures].[Evolution CA Reconnu] &lt; -0.02, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'KPI Direction\9 Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Statut Taux Marge Brute] AS
    IIF(IsEmpty([Measures].[Ecart Taux Marge Brute]), NULL,
        IIF([Measures].[Ecart Taux Marge Brute] &gt; 0.5, 1, IIF([Measures].[Ecart Taux Marge Brute] &lt; -0.5, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'KPI Direction\9 Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Statut Panier Moyen] AS
    IIF(IsEmpty([Measures].[Evolution Panier Moyen]), NULL,
        IIF([Measures].[Evolution Panier Moyen] &gt; 0.02, 1, IIF([Measures].[Evolution Panier Moyen] &lt; -0.02, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'KPI Direction\9 Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Statut Clients Actifs] AS
    IIF(IsEmpty([Measures].[Evolution Clients Actifs]), NULL,
        IIF([Measures].[Evolution Clients Actifs] &gt; 0.02, 1, IIF([Measures].[Evolution Clients Actifs] &lt; -0.02, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'KPI Direction\9 Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Statut Taux Rupture Stock] AS
    IIF(IsEmpty([Measures].[Ecart Taux Rupture Stock]), NULL,
        IIF([Measures].[Ecart Taux Rupture Stock] &gt; 0.5, -1, IIF([Measures].[Ecart Taux Rupture Stock] &lt; -0.5, 1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'KPI Direction\9 Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Statut Taux Service Fournisseur] AS
    IIF(IsEmpty([Measures].[Ecart Taux Service Fournisseur]), NULL,
        IIF([Measures].[Ecart Taux Service Fournisseur] &gt; 0.5, 1, IIF([Measures].[Ecart Taux Service Fournisseur] &lt; -0.5, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'KPI Direction\9 Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Statut OTD] AS
    IIF(IsEmpty([Measures].[Ecart OTD]), NULL,
        IIF([Measures].[Ecart OTD] &gt; 0.5, 1, IIF([Measures].[Ecart OTD] &lt; -0.5, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'KPI Direction\9 Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Statut Note Moyenne] AS
    IIF(IsEmpty([Measures].[Evolution Note Moyenne]), NULL,
        IIF([Measures].[Evolution Note Moyenne] &gt; 0.02, 1, IIF([Measures].[Evolution Note Moyenne] &lt; -0.02, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'KPI Direction\9 Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Statut ROAS] AS
    IIF(IsEmpty([Measures].[Evolution ROAS]), NULL,
        IIF([Measures].[Evolution ROAS] &gt; 0.02, 1, IIF([Measures].[Evolution ROAS] &lt; -0.02, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'KPI Direction\9 Feux', VISIBLE = 1;

/* ---------- 10. Couleurs des feux (pour la mise en forme « Valeur du champ » de Power BI) ---------- */
CREATE MEMBER CURRENTCUBE.[Measures].[Couleur CA Reconnu] AS
    IIF(IsEmpty([Measures].[Statut CA Reconnu]), "#5B6B7C",
        IIF([Measures].[Statut CA Reconnu] = 1, "#1E7B4F", IIF([Measures].[Statut CA Reconnu] = -1, "#B42318", "#5B6B7C"))),
    DISPLAY_FOLDER = 'KPI Direction\9 Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Couleur Taux Marge Brute] AS
    IIF(IsEmpty([Measures].[Statut Taux Marge Brute]), "#5B6B7C",
        IIF([Measures].[Statut Taux Marge Brute] = 1, "#1E7B4F", IIF([Measures].[Statut Taux Marge Brute] = -1, "#B42318", "#5B6B7C"))),
    DISPLAY_FOLDER = 'KPI Direction\9 Feux', VISIBLE = 1;
