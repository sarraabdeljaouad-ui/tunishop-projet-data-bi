        IIF([Measures].[Statut Panier Moyen] = 1, "#1E7B4F", IIF([Measures].[Statut Panier Moyen] = -1, "#B42318", "#5B6B7C"))),
    DISPLAY_FOLDER = 'KPI Direction\9 Feux', VISIBLE = 1;
