    IIF(IsEmpty([Measures].[Statut Taux Rupture Stock]), "#5B6B7C",
        IIF([Measures].[Statut Taux Rupture Stock] = 1, "#1E7B4F", IIF([Measures].[Statut Taux Rupture Stock] = -1, "#B42318", "#5B6B7C"))),
    DISPLAY_FOLDER = 'KPI Direction\9 Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Couleur Taux Service Fournisseur] AS
    IIF(IsEmpty([Measures].[Statut Taux Service Fournisseur]), "#5B6B7C",
        IIF([Measures].[Statut Taux Service Fournisseur] = 1, "#1E7B4F", IIF([Measures].[Statut Taux Service Fournisseur] = -1, "#B42318", "#5B6B7C"))),
    DISPLAY_FOLDER = 'KPI Direction\9 Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Couleur OTD] AS
    IIF(IsEmpty([Measures].[Statut OTD]), "#5B6B7C",
        IIF([Measures].[Statut OTD] = 1, "#1E7B4F", IIF([Measures].[Statut OTD] = -1, "#B42318", "#5B6B7C"))),
    DISPLAY_FOLDER = 'KPI Direction\9 Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Couleur Note Moyenne] AS
    IIF(IsEmpty([Measures].[Statut Note Moyenne]), "#5B6B7C",
        IIF([Measures].[Statut Note Moyenne] = 1, "#1E7B4F", IIF([Measures].[Statut Note Moyenne] = -1, "#B42318", "#5B6B7C"))),
    DISPLAY_FOLDER = 'KPI Direction\9 Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Couleur ROAS] AS
