><Partition><ID>Paiements</ID><Name>Paiements</Name><Source xsi:type="DsvTableBinding"><DataSourceViewID>TuniShop</DataSourceViewID><TableID>olap_v_fact_paiements</TableID></Source><StorageMode>Molap</StorageMode><ProcessingMode>Regular</ProcessingMode></Partition></Partitions></MeasureGroup></MeasureGroups><Source><DataSourceViewID>TuniShop</DataSourceViewID></Source></Cube><Cube ><ID>Stock</ID><Name>Stock</Name><Language>1036</Language><Collation>Latin1_General_CI_AS</Collation><Dimensions><Dimension><ID>Date</ID><Name>Date</Name><DimensionID>Date</DimensionID><Attributes><Attribute><AttributeID>Jour</AttributeID></Attribute><Attribute><AttributeID>Mois</AttributeID></Attribute><Attribute><AttributeID>Trimestre</AttributeID></Attribute><Attribute><AttributeID>Semestre</AttributeID></Attribute><Attribute><AttributeID>Annee</AttributeID></Attribute><Attribute><AttributeID>Jour Semaine</AttributeID></Attribute><Attribute><AttributeID>Periode Commerciale</AttributeID></Attribute><Attribute><AttributeID>Ramadan</AttributeID></Attribute><Attribute><AttributeID>Jour Ferie</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Calendrier</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Produit</ID><Name>Produit</Name><DimensionID>Produit</DimensionID><Attributes><Attribute><AttributeID>Produit</AttributeID></Attribute><Attribute><AttributeID>Sous Categorie</AttributeID></Attribute><Attribute><AttributeID>Categorie</AttributeID></Attribute><Attribute><AttributeID>Marque</AttributeID></Attribute><Attribute><AttributeID>Gamme Prix</AttributeID></Attribute><Attribute><AttributeID>Statut Produit</AttributeID></Attribute><Attribute><AttributeID>Code Produit</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Categories</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Entrepot</ID><Name>Entrepôt</Name><DimensionID>Entrepot</DimensionID><Attributes><Attribute><AttributeID>Entrepot</AttributeID></Attribute><Attribute><AttributeID>Region</AttributeID></Attribute></Attributes></Dimension><Dimension><ID>Type Mouvement</ID><Name>Type Mouvement</Name><DimensionID>Type Mouvement</DimensionID><Attributes><Attribute><AttributeID>Type Mouvement</AttributeID></Attribute><Attribute><AttributeID>Famille Mouvement</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Familles Mouvement</HierarchyID></Hierarchy></Hierarchies></Dimension></Dimensions><MdxScripts><MdxScript><ID>MdxScript</ID><Name>MdxScript</Name><Commands><Command><Text>/* =====================================================================
   11b_Calculs_Cube_Stock.mdx — TuniShop — script de calcul du cube [Stock]
   ---------------------------------------------------------------------
   Cube 2 — Stock : niveaux de fin de mois, ruptures, entrées et sorties.
   Où le coller : Visual Studio → cube Stock → onglet « Calculs »
   → « Affichage du script » → Ctrl+A → coller → Ctrl+S → Déployer.
   Mesures de base attendues dans ce cube : groupes Stock mensuel (Stock Fin Mois, Valeur Stock HT en LastNonEmpty ; Nb Inventaires, Nb Ruptures) et Mouvements stock (Quantite Mouvement, Valeur Mouvement HT, Quantite Vendue Stock, Cout Des Ventes HT) ; dimension Type Mouvement
   Règles : Dictionnaire_KPI.xlsx (partie 4). Divisions protégées (NULL si dénominateur vide).
   ===================================================================== */
CALCULATE;

CREATE MEMBER CURRENTCUBE.[Measures].[Taux Rupture Stock] AS
    IIF([Measures].[Nb Inventaires] = 0, NULL, [Measures].[Nb Ruptures] / [Measures].[Nb Inventaires]),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Operations', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Entrees Stock] AS
    ([Measures].[Quantite Mouvement], [Type Mouvement].[Famille Mouvement].&amp;[Entrée]),
    FORMAT_STRING = "#,##0", DISPLAY_FOLDER = 'KPI\Stock', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Sorties Stock] AS
    -([Measures].[Quantite Mouvement], [Type Mouvement].[Famille Mouvement].&amp;[Sortie]),
    FORMAT_STRING = "#,##0", DISPLAY_FOLDER = 'KPI\Stock', VISIBLE = 1;
</Text></Command></Commands></MdxScript></MdxScripts><MeasureGroups><MeasureGroup><ID>Stock mensuel</ID><Name>Stock mensuel</Name><Measures><Measure><ID>Nb Inventaires</ID><Name>Nb Inventaires</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_stock_mensuel</TableID><ColumnID>nb_inventaires</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Nb Ruptures</ID><Name>Nb Ruptures</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_stock_mensuel</TableID><ColumnID>nb_ruptures</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Stock Fin Mois</ID><Name>Stock Fin Mois</Name><AggregateFunction>LastNonEmpty</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_stock_mensuel</TableID><ColumnID>stock_fin_mois</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Quantite En Commande</ID><Name>Quantite En Commande</Name><AggregateFunction>LastNonEmpty</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_stock_mensuel</TableID><ColumnID>quantite_en_commande</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Valeur Stock HT</ID><Name>Valeur Stock HT</Name><AggregateFunction>LastNonEmpty</AggregateFunction><DataType>Double</DataType><Source><DataType>Double</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_stock_mensuel</TableID><ColumnID>valeur_stock_ht</ColumnID></Source></Source><FormatString>#,##0.000</FormatString></Measure></Measures><StorageMode>Molap</StorageMode><ProcessingMode>Regular</ProcessingMode><Dimensions><Dimension xsi:type="RegularM