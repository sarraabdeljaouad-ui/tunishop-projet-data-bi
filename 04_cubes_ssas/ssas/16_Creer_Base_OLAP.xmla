e</OrderBy></Attribute><Attribute><ID>Canal Media</ID><Name>Canal Média</Name><KeyColumns><KeyColumn><DataType>WChar</DataType><DataSize>15</DataSize><Source xsi:type="ColumnBinding"><TableID>olap_v_dim_campagne</TableID><ColumnID>canal_media</ColumnID></Source></KeyColumn></KeyColumns><OrderBy>Name</OrderBy></Attribute><Attribute><ID>Type Canal</ID><Name>Type canal</Name><KeyColumns><KeyColumn><DataType>WChar</DataType><DataSize>15</DataSize><Source xsi:type="ColumnBinding"><TableID>olap_v_dim_campagne</TableID><ColumnID>type_canal</ColumnID></Source></KeyColumn></KeyColumns><OrderBy>Name</OrderBy></Attribute><Attribute><ID>Objectif</ID><Name>Objectif</Name><KeyColumns><KeyColumn><DataType>WChar</DataType><DataSize>15</DataSize><Source xsi:type="ColumnBinding"><TableID>olap_v_dim_campagne</TableID><ColumnID>objectif</ColumnID></Source></KeyColumn></KeyColumns><OrderBy>Name</OrderBy></Attribute><Attribute><ID>Theme</ID><Name>Thème</Name><KeyColumns><KeyColumn><DataType>WChar</DataType><DataSize>15</DataSize><Source xsi:type="ColumnBinding"><TableID>olap_v_dim_campagne</TableID><ColumnID>theme</ColumnID></Source></KeyColumn></KeyColumns><OrderBy>Name</OrderBy></Attribute></Attributes><Hierarchies><Hierarchy><ID>Medias</ID><Name>Médias</Name><Levels><Level><ID>Canal Media</ID><Name>Canal Média</Name><SourceAttributeID>Canal Media</SourceAttributeID></Level><Level><ID>Campagne</ID><Name>Campagne</Name><SourceAttributeID>Campagne</SourceAttributeID></Level></Levels></Hierarchy></Hierarchies></Dimension><Dimension ><ID>Motif Retour</ID><Name>Motif Retour</Name><Source xsi:type="DataSourceViewBinding"><DataSourceViewID>TuniShop</DataSourceViewID></Source><Language>1036</Language><Collation>Latin1_General_CI_AS</Collation><Attributes><Attribute><ID>Motif</ID><Name>Motif</Name><Usage>Key</Usage><KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_dim_motif_retour</TableID><ColumnID>motif_retour_sk</ColumnID></Source></KeyColumn></KeyColumns><NameColumn><DataType>WChar</DataType><DataSize>60</DataSize><Source xsi:type="ColumnBinding"><TableID>olap_v_dim_motif_retour</TableID><ColumnID>libelle_motif</ColumnID></Source></NameColumn><AttributeRelationships><AttributeRelationship><AttributeID>Type Remboursement</AttributeID><Name>Type remboursement</Name></AttributeRelationship><AttributeRelationship><AttributeID>Responsabilite</AttributeID><Name>Responsabilité</Name></AttributeRelationship></AttributeRelationships><OrderBy>Name</OrderBy></Attribute><Attribute><ID>Type Remboursement</ID><Name>Type remboursement</Name><KeyColumns><KeyColumn><DataType>WChar</DataType><DataSize>20</DataSize><Source xsi:type="ColumnBinding"><TableID>olap_v_dim_motif_retour</TableID><ColumnID>type_remboursement</ColumnID></Source></KeyColumn></KeyColumns><OrderBy>Name</OrderBy></Attribute><Attribute><ID>Responsabilite</ID><Name>Responsabilité</Name><KeyColumns><KeyColumn><DataType>WChar</DataType><DataSize>15</DataSize><Source xsi:type="ColumnBinding"><TableID>olap_v_dim_motif_retour</TableID><ColumnID>responsabilite</ColumnID></Source></KeyColumn></KeyColumns><OrderBy>Name</OrderBy></Attribute></Attributes><Hierarchies><Hierarchy><ID>Types</ID><Name>Types</Name><Levels><Level><ID>Type Remboursement</ID><Name>Type remboursement</Name><SourceAttributeID>Type Remboursement</SourceAttributeID></Level><Level><ID>Motif</ID><Name>Motif</Name><SourceAttributeID>Motif</SourceAttributeID></Level></Levels></Hierarchy></Hierarchies></Dimension><Dimension ><ID>Type Mouvement</ID><Name>Type Mouvement</Name><Source xsi:type="DataSourceViewBinding"><DataSourceViewID>TuniShop</DataSourceViewID></Source><Language>1036</Language><Collation>Latin1_General_CI_AS</Collation><Attributes><Attribute><ID>Type Mouvement</ID><Name>Type Mouvement</Name><Usage>Key</Usage><KeyColumns><KeyColumn><DataType>WChar</DataType><DataSize>30</DataSize><Source xsi:type="ColumnBinding"><TableID>olap_v_dim_type_mouvement</TableID><ColumnID>type_mouvement</ColumnID></Source></KeyColumn></KeyColumns><AttributeRelationships><AttributeRelationship><AttributeID>Famille Mouvement</AttributeID><Name>Famille Mouvement</Name></AttributeRelationship></AttributeRelationships><OrderBy>Name</OrderBy></Attribute><Attribute><ID>Famille Mouvement</ID><Name>Famille Mouvement</Name><KeyColumns><KeyColumn><DataType>WChar</DataType><DataSize>10</DataSize><Source xsi:type="ColumnBinding"><TableID>olap_v_dim_type_mouvement</TableID><ColumnID>famille_mouvement</ColumnID></Source></KeyColumn></KeyColumns><OrderBy>Name</OrderBy></Attribute></Attributes><Hierarchies><Hierarchy><ID>Familles Mouvement</ID><Name>Familles mouvement</Name><Levels><Level><ID>Famille Mouvement</ID><Name>Famille Mouvement</Name><SourceAttributeID>Famille Mouvement</SourceAttributeID></Level><Level><ID>Type Mouvement</ID><Name>Type Mouvement</Name><SourceAttributeID>Type Mouvement</SourceAttributeID></Level></Levels></Hierarchy></Hierarchies></Dimension></Dimensions><Cubes><Cube ><ID>Ventes</ID><Name>Ventes</Name><Language>1036</Language><Collation>Latin1_General_CI_AS</Collation><Dimensions><Dimension><ID>Date</ID><Name>Date</Name><DimensionID>Date</DimensionID><Attributes><Attribute><AttributeID>Jour</AttributeID></Attribute><Attribute><AttributeID>Mois</AttributeID></Attribute><Attribute><AttributeID>Trimestre</AttributeID></Attribute><Attribute><AttributeID>Semestre</AttributeID></Attribute><Attribute><AttributeID>Annee</AttributeID></Attribute><Attribute><AttributeID>Jour Semaine</AttributeID></Attribute><Attribute><AttributeID>Periode Commerciale</AttributeID></Attribute><Attribute><AttributeID>Ramadan</AttributeID></Attribute><Attribute><AttributeID>Jour Ferie</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Calendrier</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Produit</ID><Name>Produit</Name><DimensionID>Produit</DimensionID><Attributes><Attribute><AttributeID>Produit</AttributeID></Attribute><Attribute><AttributeID>Sous Categorie</AttributeID></Attribute><Attribute><AttributeID>Categorie</AttributeID></Attribute><Attribute><AttributeID>Marque</AttributeID></Attribute><Attribute><AttributeID>Gamme Prix</AttributeID></Attribute><Attribute><AttributeID>Statut Produit</AttributeID></Attribute><Attribute><AttributeID>Code Produit</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Categories</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Client</ID><Name>Client</Name><DimensionID>Client</DimensionID><Attributes><Attribute><AttributeID>Client</AttributeID></Attribute><Attribute><AttributeID>Gouvernorat</AttributeID></Attribute><Attribute><AttributeID>Region</AttributeID></Attribute><Attribute><AttributeID>Segment Fidelite</AttributeID></Attribute><Attribute><AttributeID>Type Client</AttributeID></Attribute><Attribute><AttributeID>Tranche Age</AttributeID></Attribute><Attribute><AttributeID>Canal Inscription</AttributeID></Attribute><Attribute><AttributeID>Cohorte Inscription</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Geographie Client</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Geographie</ID><Name>Géographie</Name><DimensionID>Geographie</DimensionID><Attributes><Attribute><AttributeID>Gouvernorat</AttributeID></Attribute><Attribute><AttributeID>Region</AttributeID></Attribute><Attribute><AttributeID>Zone Livraison</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Regions</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Canal</ID><Name>Canal</Name><DimensionID>Canal</DimensionID><Attributes><Attribute><AttributeID>Canal Appareil</AttributeID></Attribute><Attribute><AttributeID>Canal</AttributeID></Attribute><Attribute><AttributeID>Appareil</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Canaux</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Mode Paiement</ID><Name>Mode Paiement</Name><DimensionID>Mode Paiement</DimensionID><Attributes><Attribute><AttributeID>Libelle Mode Paiement</AttributeID></Attribute><Attribute><AttributeID>Mode Paiement</AttributeID></Attribute></Attributes></Dimension><Dimension><ID>Statut Commande</ID><Name>Statut Commande</Name><DimensionID>Statut Commande</DimensionID><Attributes><Attribute><AttributeID>Libelle</AttributeID></Attribute><Attribute><AttributeID>Famille Statut</AttributeID></Attribute><Attribute><AttributeID>Statut</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Familles</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Coupon</ID><Name>Coupon</Name><DimensionID>Coupon</DimensionID><Attributes><Attribute><AttributeID>Coupon</AttributeID></Attribute><Attribute><AttributeID>Type Remise</AttributeID></Attribute></Attributes></Dimension><Dimension><ID>Entrepot</ID><Name>Entrepôt</Name><DimensionID>Entrepot</DimensionID><Attributes><Attribute><AttributeID>Entrepot</AttributeID></Attribute><Attribute><AttributeID>Region</AttributeID></Attribute></Attributes></Dimension></Dimensions><MdxScripts><MdxScript><ID>MdxScript</ID><Name>MdxScript</Name><Commands><Command><Text>/* =====================================================================
   11a_Calculs_Cube_Ventes.mdx — TuniShop — script de calcul du cube [Ventes]
   ---------------------------------------------------------------------
   Cube 1 — Ventes : chiffre d'affaires, marge, panier, canaux, annulations, paiements.
   Où le coller : Visual Studio → cube Ventes → onglet « Calculs »
   → « Affichage du script » → Ctrl+A → coller → Ctrl+S → Déployer.
   Mesures de base attendues dans ce cube : groupes Ventes, Commandes, Paiements (Nb Lignes Vente, Montant Total TTC, Nb Commandes, Montant Ligne HT, Marge Brute HT, Montant Brut TTC, Remise Promo TTC, Nb Articles, Montant Rembourse Commande TTC, Nb Tentatives Paiement, Nb Paiements Reussis…)
   Règles : Dictionnaire_KPI.xlsx (partie 4). Divisions protégées (NULL si dénominateur vide).
   ===================================================================== */
CALCULATE;

CREATE MEMBER CURRENTCUBE.[Measures].[CA Commande TTC] AS
    [Measures].[Montant Total TTC],
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Commandes Passees] AS
    [Measures].[Nb Commandes],
    FORMAT_STRING = "#,##0", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[CA Reconnu TTC] AS
    ([Measures].[Montant Total TTC], [Statut Commande].[Famille Statut].&amp;[aboutie]),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Commandes Reconnues] AS
    ([Measures].[Nb Commandes], [Statut Commande].[Famille Statut].&amp;[aboutie]),
    FORMAT_STRING = "#,##0", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Rembourse TTC] AS
    ([Measures].[Montant Rembourse Commande TTC], [Statut Commande].[Famille Statut].&amp;[aboutie]),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[CA Net TTC] AS
    [Measures].[CA Reconnu TTC] - [Measures].[Rembourse TTC],
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[CA HT Reconnu] AS
    ([Measures].[Montant Ligne HT], [Statut Commande].[Famille Statut].&amp;[aboutie]),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Marge Brute Reconnue HT] AS
    ([Measures].[Marge Brute HT], [Statut Commande].[Famille Statut].&amp;[aboutie]),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Taux Marge Brute] AS
    IIF([Measures].[CA HT Reconnu] = 0, NULL, [Measures].[Marge Brute Reconnue HT] / [Measures].[CA HT Reconnu]),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Panier Moyen TTC] AS
    IIF([Measures].[Commandes Reconnues] = 0, NULL, [Measures].[CA Reconnu TTC] / [Measures].[Commandes Reconnues]),
    FORMAT_STRING = "#,##0.00", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Articles Par Commande] AS
    IIF([Measures].[Commandes Reconnues] = 0, NULL,
        ([Measures].[Nb Articles], [Statut Commande].[Famille Statut].&amp;[aboutie]) / [Measures].[Commandes Reconnues]),
    FORMAT_STRING = "0.000", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Taux Remise Produit] AS
    IIF(([Measures].[Montant Brut TTC], [Statut Commande].[Famille Statut].&amp;[aboutie]) = 0, NULL,
        ([Measures].[Remise Promo TTC], [Statut Commande].[Famille Statut].&amp;[aboutie])
        / ([Measures].[Montant Brut TTC], [Statut Commande].[Famille Statut].&amp;[aboutie])),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;

-- Parts : numérateur = un canal / un mode ; dénominateur = tous les canaux / tous les modes
CREATE MEMBER CURRENTCUBE.[Measures].[Part Application Mobile] AS
    IIF(([Measures].[Nb Commandes], [Canal].[Canal].[All]) = 0, NULL,
        ([Measures].[Nb Commandes], [Canal].[Canal].&amp;[application_mobile])
        / ([Measures].[Nb Commandes], [Canal].[Canal].[All])),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Part Paiement A La Livraison] AS
    IIF(([Measures].[Nb Commandes], [Mode Paiement].[Mode Paiement].[All]) = 0, NULL,
        ([Measures].[Nb Commandes], [Mode Paiement].[Mode Paiement].&amp;[paiement_a_la_livraison])
        / ([Measures].[Nb Commandes], [Mode Paiement].[Mode Paiement].[All])),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Taux Annulation] AS
    IIF(([Measures].[Nb Commandes], Root([Statut Commande])) = 0, NULL,
        ([Measures].[Nb Commandes], [Statut Commande].[Statut].&amp;[annulee])
        / ([Measures].[Nb Commandes], Root([Statut Commande]))),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Operations', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Taux Refus Colis] AS
    IIF(([Measures].[Nb Commandes], [Statut Commande].[Famille Statut].&amp;[aboutie])
        + ([Measures].[Nb Commandes], [Statut Commande].[Statut].&amp;[livraison_echouee]) = 0, NULL,
        ([Measures].[Nb Commandes], [Statut Commande].[Statut].&amp;[livraison_echouee])
        / (([Measures].[Nb Commandes], [Statut Commande].[Famille Statut].&amp;[aboutie])
           + ([Measures].[Nb Commandes], [Statut Commande].[Statut].&amp;[livraison_echouee]))),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Operations', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Taux Echec Paiement] AS
    IIF([Measures].[Nb Tentatives Paiement] = 0, NULL,
        1 - [Measures].[Nb Paiements Reussis] / [Measures].[Nb Tentatives Paiement]),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Operations', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[CA Reconnu A-1] AS
    ([Measures].[CA Reconnu TTC],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI\Temps', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Evolution CA Reconnu] AS
    IIF(IsEmpty([Measures].[CA Reconnu TTC]) OR IsEmpty([Measures].[CA Reconnu A-1]) OR [Measures].[CA Reconnu A-1] = 0, NULL,
        ([Measures].[CA Reconnu TTC] - [Measures].[CA Reconnu A-1]) / [Measures].[CA Reconnu A-1]),
    FORMAT_STRING = "0.0%", DISPLAY_FOLDER = 'KPI\Temps', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[CA Reconnu Cumul Annuel] AS
    Sum(PeriodsToDate([Date].[Calendrier].[Année], [Date].[Calendrier].CurrentMember),
        [Measures].[CA Reconnu TTC]),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI\Temps', VISIBLE = 1;
</Text></Command></Commands></MdxScript></MdxScripts><MeasureGroups><MeasureGroup><ID>Ventes</ID><Name>Ventes</Name><Measures><Measure><ID>Nb Lignes Vente</ID><Name>Nb Lignes Vente</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_ventes</TableID><ColumnID>nb_lignes</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Quantite Vendue</ID><Name>Quantite Vendue</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_ventes</TableID><ColumnID>quantite</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Montant Brut TTC</ID><Name>Montant Brut TTC</Name><AggregateFunction>Sum</AggregateFunction><DataType>Double</DataType><Source><DataType>Double</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_ventes</TableID><ColumnID>montant_brut_ttc</ColumnID></Source></Source><FormatString>#,##0.000</FormatString></Measure><Measure><ID>Remise Promo TTC</ID><Name>Remise Promo TTC</Name><AggregateFunction>Sum</AggregateFunction><DataType>Double</DataType><Source><DataType>Double</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_ventes</TableID><ColumnID>montant_remise_promo_ttc</ColumnID></Source></Source><FormatString>#,##0.000</FormatString></Measure><Measure><ID>Montant Ligne TTC</ID><Name>Montant Ligne TTC</Name><AggregateFunction>Sum</AggregateFunction><DataType>Double</DataType><Source><DataType>Double</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_ventes</TableID><ColumnID>montant_ttc</ColumnID></Source></Source><FormatString>#,##0.000</FormatString></Measure><Measure><ID>Montant Ligne HT</ID><Name>Montant Ligne HT</Name><AggregateFunction>Sum</AggregateFunction><DataType>Double</DataType><Source><DataType>Double</DataType><Source xsi:type="ColumnB