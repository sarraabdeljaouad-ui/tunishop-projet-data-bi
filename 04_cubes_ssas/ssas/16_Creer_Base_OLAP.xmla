Function>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_mouvements_stock</TableID><ColumnID>quantite</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Valeur Mouvement HT</ID><Name>Valeur Mouvement HT</Name><AggregateFunction>Sum</AggregateFunction><DataType>Double</DataType><Source><DataType>Double</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_mouvements_stock</TableID><ColumnID>valeur_ht</ColumnID></Source></Source><FormatString>#,##0.000</FormatString></Measure><Measure><ID>Quantite Vendue Stock</ID><Name>Quantite Vendue Stock</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_mouvements_stock</TableID><ColumnID>quantite_vendue</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Cout Des Ventes HT</ID><Name>Cout Des Ventes HT</Name><AggregateFunction>Sum</AggregateFunction><DataType>Double</DataType><Source><DataType>Double</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_mouvements_stock</TableID><ColumnID>cout_des_ventes_ht</ColumnID></Source></Source><FormatString>#,##0.000</FormatString></Measure></Measures><StorageMode>Molap</StorageMode><ProcessingMode>Regular</ProcessingMode><Dimensions><Dimension xsi:type="RegularMeasureGroupDimension"><CubeDimensionID>Date</CubeDimensionID><Attributes><Attribute><AttributeID>Jour</AttributeID><KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_mouvements_stock</TableID><ColumnID>date_sk</ColumnID></Source></KeyColumn></KeyColumns><Type>Granularity</Type></Attribute></Attributes></Dimension><Dimension xsi:type="RegularMeasureGroupDimension"><CubeDimensionID>Produit</CubeDimensionID><Attributes><Attribute><AttributeID>Produit</AttributeID><KeyColumns><KeyColumn><Data