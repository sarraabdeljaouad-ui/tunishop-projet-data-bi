ute><AttributeID>Jour Semaine</AttributeID></Attribute><Attribute><AttributeID>Periode Commerciale</AttributeID></Attribute><Attribute><AttributeID>Ramadan</AttributeID></Attribute><Attribute><AttributeID>Jour Ferie</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Calendrier</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Fournisseur</ID><Name>Fournisseur</Name><DimensionID>Fournisseur</DimensionID><Attributes><Attribute><AttributeID>Fournisseur</AttributeID></Attribute><Attribute><AttributeID>Pays</AttributeID></Attribute><Attribute><AttributeID>Origine</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Origines</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Produit</ID><Name>Produit</Name><DimensionID>Produit</DimensionID><Attributes><Attribute><AttributeID>Produit</AttributeID></Attribute><Attribute><AttributeID>Sous Categorie</AttributeID></Attribute><Attribute><AttributeID>Categorie</AttributeID></Attribute><Attribute><AttributeID>Marque</AttributeID></Attribute><Attribute><AttributeID>Gamme Prix</AttributeID></Attribute><Attribute><AttributeID>Statut Produit</AttributeID></Attribute><Attribute><AttributeID>Code Produit</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Categories</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Entrepot</ID><Name>Entrepôt</Name><DimensionID>Entrepot</DimensionID><Attributes><Attribute><AttributeID>Entrepot</AttributeID></Attribute><Attribute><AttributeID>Region</AttributeID></Attribute></Attributes></Dimension></Dimensions><MdxScripts><MdxScript><ID>MdxScript</ID><Name>MdxScript</Name><Commands><Command><Text>/* =====================================================================
   11c_Calculs_Cube_Achats.mdx — TuniShop — script de calcul du cube [Achats]
   ---------------------------------------------------------------------
   Cube 3 — Achats : achats fournisseurs, réceptions, délais et retards.
   Où le coller : Visual Studio → cube Achats → onglet « Calculs »
   → « Affichage du script » → Ctrl+A → coller → Ctrl+S → Déployer.
   Mesures de base attendues dans ce cube : groupe Achats (Montant Achat HT, Quantite Commandee, Quantite Commandee Recue, Quantite Recue, Nb Lignes Achat, Nb Lignes Recues, Nb Receptions Partielles, Somme Delai Appro J, Somme Retard Appro J)
   Règles : Dictionnaire_KPI.xlsx (partie 4). Divisions protégées (NULL si dénominateur vide).
   ===================================================================== */
CALCULATE;

CREATE MEMBER CURRENTCUBE.[Measures].[Taux Rupture Fournisseur] AS
    IIF([Measures].[Nb Lignes Recues] = 0, NULL, [Measures].[Nb Receptions Partielles] / [Measures].[Nb Lignes Recues]),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Stock et achats', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Taux Service Fournisseur] AS
    IIF([Measures].[Quantite Commandee Recue] = 0, NULL, [Measures].[Quantite Recue] / [Measures].[Quantite Commandee Recue]),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Stock et achats', VISIBLE = 1;

-- Délai entre la commande fournisseur et sa réception, par ligne réceptionnée
CREATE MEMBER CURRENTCUBE.[Measures].[Delai Moyen Appro J] AS
    IIF([Measures].[Nb Lignes Recues] = 0, NULL, [Measures].[Somme Delai Appro J] / [Measures].[Nb Lignes Recues]),
    FORMAT_STRING = "0.00", DISPLAY_FOLDER = 'KPI\Achats', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Retard Moyen Appro J] AS
    IIF([Measures].[Nb Lignes Recues] = 0, NULL, [Measures].[Somme Retard Appro J] / [Measures].[Nb Lignes Recues]),
    FORMAT_STRING = "0.00", DISPLAY_FOLDER = 'KPI\Achats', VISIBLE = 1;
</Text></Command></Commands></MdxScript></MdxScripts><MeasureGroups><MeasureGroup><ID>Achats</ID><Name>Achats</Name><Measures><Measure><ID>Nb Lignes Achat</ID><Name>Nb Lignes Achat</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_achats_fournisseur</TableID><ColumnID>nb_lignes_cf</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Nb Lignes Recues</ID><Name>Nb Lignes Recues</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_achats_fournisseur</TableID><ColumnID>nb_lignes_recues</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Nb Receptions Partielles</ID><Name>Nb Receptions Partielles</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_achats_fournisseur</TableID><ColumnID>nb_receptions_partielles</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Quantite Commandee</ID><Name>Quantite Commandee</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_achats_fournisseur</TableID><ColumnID>quantite_commandee</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Quantite Commandee Recue</ID><Name>Quantite Commandee Recue</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_achats_fournisseur</TableID><ColumnID>quantite_commandee_recue</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Quantite Recue</ID><Name>Quantite Recue</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_achats_fournisseur</TableID><ColumnID>quantite_recue</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Montant Achat HT</ID><Name>Montant Achat HT</Name><AggregateFunction>Sum</AggregateFunction><DataType>Double</DataType><Source><DataType>Double</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_achats_fournisseur</TableID><ColumnID>montant_ht</ColumnID></Source></Source><FormatString>#,##0.000</FormatString></Measure><Measure><ID>Somme Delai Appro J</ID><Name>Somme Delai Appro J</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_achats_fournisseur</TableID><ColumnID>delai_appro_j</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Somme Retard Appro J</ID><Name>Somme Retard Appro J</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_achats_fournisseur</TableID><ColumnID>retard_appro_j</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure></Measures><StorageMode>Molap</StorageMode><ProcessingMode>Regular</ProcessingMode><Dimensions><Dimension xsi:type="RegularMeasureGroupDimension"><CubeDimensionID>Date</CubeDimensionID><Attributes><Attribute><AttributeID>Jour</AttributeID><KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_achats_fournisseur</TableID><ColumnID>date_commande_sk</ColumnID></Source></KeyColumn></KeyColumns><Type>Granularity</Type></Attribute></Attributes></Dimension><Dimension xsi:type="RegularMeasureGroupDimension"><CubeDimensionID>Fournisseur</CubeDimensionID><Attributes><Attribute><AttributeID>Fournisseur</AttributeID><KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_achats_fournisseur</TableID><ColumnID>fournisseur_sk</ColumnID></Source></KeyColumn></KeyColumns><Type>Granularity</Type></Attribute></Attributes></Dimension><Dimension xsi:type="RegularMeasureGroupDimension"><CubeDimensionID>Produit</CubeDimensionID><Attributes><Attribute><AttributeID>Produit</AttributeID><KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_achats_fournisseur</TableID><ColumnID>produit_sk</ColumnID></Source></KeyColumn></KeyColumns><Type>Granularity</Type></Attribute></Attributes></Dimension><Dimension xsi:type="RegularMeasureGroupDimension"><CubeDimensionID>Entrepot</CubeDimensionID><Attributes><Attribute><AttributeID>Entrepot</AttributeID><KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_achats_fournisseur</TableID><ColumnID>entrepot_sk</ColumnID></Source></KeyColumn></KeyColumns><Type>Granularity</Type></Attribute></Attributes></Dimension></Dimensions><Partitions><Partition><ID>Achats</ID><Name>Achats</Name><Source xsi:type="DsvTableBinding"><DataSourceViewID>TuniShop</DataSourceViewID><TableID>olap_v_fact_achats_fournisseur</TableID></Source><StorageMode>Molap</StorageMode><ProcessingMode>Regular</ProcessingMode></Partition></Partitions></MeasureGroup></MeasureGroups><Source><DataSourceViewID>TuniShop</DataSourceViewID></Source></Cube><Cube ><ID>Livraisons</ID><Name>Livraisons</Name><Language>1036</Language><Collation>Latin1_General_CI_AS</Collation><Dimensions><Dimension><ID>Date</ID><Name>Date</Name><DimensionID>Date</DimensionID><Attributes><Attribute><AttributeID>Jour</AttributeID></Attribute><Attribute><AttributeID>Mois</AttributeID></Attribute><Attribute><AttributeID>Trimestre</AttributeID></Attribute><Attribute><AttributeID>Semestre</AttributeID></Attribute><Attribute><AttributeID>Annee</AttributeID></Attribute><Attribute><AttributeID>Jour Semaine</AttributeID></Attribute><Attribute><AttributeID>Periode Commerciale</AttributeID></Attribute><Attribute><AttributeID>Ramadan</AttributeID></Attribute><Attribute><AttributeID>Jour Ferie</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Calendrier</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Date Livraison</ID><Name>Date Livraison</Name><DimensionID>Date</DimensionID><Attributes><Attribute><AttributeID>Jour</AttributeID></Attribute><Attribute><AttributeID>Mois</AttributeID></Attribute><Attribute><AttributeID>Trimestre</AttributeID></Attribute><Attribute><AttributeID>Semestre</AttributeID></Attribute><Attribute><AttributeID>Annee</AttributeID></Attribute><Attribute><AttributeID>Jour Semaine</AttributeID></Attribute><Attribute><AttributeID>Periode Commerciale</AttributeID></Attribute><Attribute><AttributeID>Ramadan</AttributeID></Attribute><Attribute><AttributeID>Jour Ferie</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Calendrier</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Transporteur</ID><Name>Transporteur</Name><DimensionID>Transporteur</DimensionID><Attributes><Attribute><AttributeID>Transporteur</AttributeID></Attribute><Attribute><AttributeID>Couverture</AttributeID></Attribute></Attributes></Dimension><Dimension><ID>Geographie</ID><Name>Géographie</Name><DimensionID>Geographie</DimensionID><Attributes><Attribute><AttributeID>Gouvernorat</AttributeID></Attribute><Attribute><AttributeID>Region</AttributeID></Attribute><Attribute><AttributeID>Zone Livraison</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Regions</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Entrepot</ID><Name>Entrepôt</Name><DimensionID>Entrepot</DimensionID><Attributes><Attribute><AttributeID>Entrepot</AttributeID></Attribute><Attribute><AttributeID>Region</AttributeID></Attribute></Attributes></Dimension><Dimension><ID>Client</ID><Name>Client</Name><DimensionID>Client</DimensionID><Attributes><Attribute><AttributeID>Client</AttributeID></Attribute><Attribute><AttributeID>Gouvernorat</AttributeID></Attribute><Attribute><AttributeID>Region</AttributeID></Attribute><Attribute><AttributeID>Segment Fidelite</AttributeID></Attribute><Attribute><AttributeID>Type Client</AttributeID></Attribute><Attribute><AttributeID>Tranche Age</AttributeID></Attribute><Attribute><AttributeID>Canal Inscription</AttributeID></Attribute><Attribute><AttributeID>Cohorte Inscription</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Geographie Client</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Produit</ID><Name>Produit</Name><DimensionID>Produit</DimensionID><Attributes><Attribute><AttributeID>Produit</AttributeID></Attribute><Attribute><AttributeID>Sous Categorie</AttributeID></Attribute><Attribute><AttributeID>Categorie</AttributeID></Attribute><Attribute><AttributeID>Marque</AttributeID></Attribute><Attribute><AttributeID>Gamme Prix</AttributeID></Attribute><Attribute><AttributeID>Statut Produit</AttributeID></Attribute><Attribute><AttributeID>Code Produit</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Categories</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Motif Retour</ID><Name>Motif Retour</Name><DimensionID>Motif Retour</DimensionID><Attributes><Attribute><AttributeID>Motif</AttributeID></Attribute><Attribute><AttributeID>Type Remboursement</AttributeID></Attribute><Attribute><AttributeID>Responsabilite</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Types</HierarchyID></Hierarchy></Hierarchies></Dimension></Dimensions><MdxScripts><MdxScript><ID>MdxScript</ID><Name>MdxScript</Name><Commands><Command><Text>/* =====================================================================
   11d_Calculs_Cube_Livraisons.mdx — TuniShop — script de calcul du cube [Livraisons]
   ---------------------------------------------------------------------
   Cube 4 — Livraisons : délais, ponctualité, coûts, retours et avis clients.
   Où le coller : Visual Studio → cube Livraisons → onglet « Calculs »
   → « Affichage du script » → Ctrl+A → coller → Ctrl+S → Déployer.
   Mesures de base attendues dans ce cube : groupes Livraisons (Nb Livraisons, Nb Livrees, Nb Livrees A Temps, Nb Livrees En Retard, Nb Livrees 1er Passage, Somme Delai Livraison J, Somme Retard J, Cout Transport HT), Remboursements (Nb Retours, Nb Rembourses, Nb Delais Rembourses, Montant Rembourse TTC, Somme Delai Remboursement J) et Avis (Nb Avis, Nb Avis Notes, Nb Avis Negatifs, Somme Notes)
   Règles : Dictionnaire_KPI.xlsx (partie 4). Divisions protégées (NULL si dénominateur vide).
   ===================================================================== */
CALCULATE;

CREATE MEMBER CURRENTCUBE.[Measures].[OTD] AS
    IIF([Measures].[Nb Livrees] = 0, NULL, [Measures].[Nb Livrees A Temps] / [Measures].[Nb Livrees]),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Logistique', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Taux Retard] AS
    IIF([Measures].[Nb Livrees] = 0, NULL, [Measures].[Nb Livrees En Retard] / [Measures].[Nb Livrees]),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Logistique', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Delai Moyen Livraison J] AS
    IIF([Measures].[Nb Livrees] = 0, NULL, [Measures].[Somme Delai Livraison J] / [Measures].[Nb Livrees]),
    FORMAT_STRING = "0.00", DISPLAY_FOLDER = 'KPI\Logistique', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Retard Moyen J] AS
    IIF([Measures].[Nb Livrees En Retard] = 0, NULL, [Measures].[Somme Retard J] / [Measures].[Nb Livrees En Retard]),
    FORMAT_STRING = "0.00", DISPLAY_FOLDER = 'KPI\Logistique', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Taux Livraison 1er Passage] AS
    IIF([Measures].[Nb Livrees] = 0, NULL, [Measures].[Nb Livrees 1er Passage] / [Measures].[Nb Livrees]),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Logistique', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Cout Transport Moyen HT] AS
    IIF([Measures].[Nb Livraisons] = 0, NULL, [Measures].[Cout Transport HT] / [Measures].[Nb Livraisons]),
    FORMAT_STRING = "#,##0.00", DISPLAY_FOLDER = 'KPI\Logistique', VISIBLE = 1;

-- Retours acceptés ou en cours (type « retour », statut différent de « refuse ») par livraison livrée
-- Attention : indicateur par livraison, différent du taux de retour par ligne du dictionnaire (S01)
CREATE MEMBER CURRENTCUBE.[Measures].[Taux Retours] AS
    IIF([Measures].[Nb Livrees] = 0, NULL, [Measures].[Nb Retours] / [Measures].[Nb Livrees]),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\SAV', VISIBLE = 1;

-- Moyenne sur les seuls remboursements dont le délai est renseigné (comme AVERAGE / mean())
CREATE MEMBER CURRENTCUBE.[Measures].[Delai Moyen Remboursement J] AS
    IIF([Measures].[Nb Delais Rembourses] = 0, NULL, [Measures].[Somme Delai Remboursement J] / [Measures].[Nb Delais Rembourses]),
    FORMAT_STRING = "0.00", DISPLAY_FOLDER = 'KPI\SAV', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Note Moyenne] AS
    IIF([Measures].[Nb Avis Notes] = 0, NULL, [Measures].[Somme Notes] / [Measures].[Nb Avis Notes]),
    FORMAT_STRING = "0.000", DISPLAY_FOLDER = 'KPI\SAV', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Part Avis Negatifs] AS
    IIF([Measures].[Nb Avis] = 0, NULL, [Measures].[Nb Avis Negatifs] / [Measures].[Nb Avis]),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\SAV', VISIBLE = 1;
</Text></Command></Commands></MdxScript></MdxScripts><MeasureGroups><MeasureGroup><ID>Livraisons</ID><Name>Livraisons</Name><Measures><Measure><ID>Nb Livraisons</ID><Name>Nb Livraisons</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_livraisons</TableID><ColumnID>nb_livraisons</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Nb Livrees</ID><Name>Nb Livrees</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_livraisons</TableID><ColumnID>nb_livrees</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Nb Livrees A Temps</ID><Name>Nb Livrees A Temps</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_livraisons</TableID><ColumnID>nb_livrees_a_temps</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Nb Livrees En Retard</ID><Name>Nb Livrees En Retard</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_livraisons</TableID><ColumnID>nb_livrees_en_retard</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Nb Livrees 1er Passage</ID><Name>Nb Livrees 1er Passage</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_livraisons</TableID><ColumnID>nb_livrees_1er_passage</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure><Measure><ID>Somme Delai Livraison J</ID><Name>Somme Delai Livraison J</Name><AggregateFunction>Sum</AggregateFunction><DataType>Double</DataType><