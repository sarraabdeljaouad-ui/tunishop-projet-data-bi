g>#,##0</FormatString></Measure><Measure><ID>Somme Notes</ID><Name>Somme Notes</Name><AggregateFunction>Sum</AggregateFunction><DataType>Integer</DataType><Source><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_avis</TableID><ColumnID>note</ColumnID></Source></Source><FormatString>#,##0</FormatString></Measure></Measures><StorageMode>Molap</StorageMode><ProcessingMode>Regular</ProcessingMode><Dimensions><Dimension xsi:type="RegularMeasureGroupDimension"><CubeDimensionID>Date</CubeDimensionID><Attributes><Attribute><AttributeID>Jour</AttributeID><KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_avis</TableID><ColumnID>date_avis_sk</ColumnID></Source></KeyColumn></KeyColumns><Type>Granularity</Type></Attribute></Attributes></Dimension><Dimension xsi:type="RegularMeasureGroupDimension"><CubeDimensionID>Client</CubeDimensionID><Attributes><Attribute><AttributeID>Client</AttributeID><KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_avis</TableID><ColumnID>client_sk</ColumnID></Source></KeyColumn></KeyColumns><Type>Granularity</Type></Attribute></Attributes></Dimension><Dimension xsi:type="RegularMeasureGroupDimension"><CubeDimensionID>Produit</CubeDimensionID><Attributes><Attribute><AttributeID>Produit</AttributeID><KeyColumns><KeyColumn><DataType>Integer</DataType><Source xsi:type="ColumnBinding"><TableID>olap_v_fact_avis</TableID><ColumnID>produit_sk</ColumnID></Source></KeyColumn></KeyColumns><Type>Granularity</Type></Attribute></Attributes></Dimension></Dimensions><Partitions><Partition><ID>Avis</ID><Name>Avis</Name><Source xsi:type="DsvTableBinding"><DataSourceViewID>TuniShop</DataSourceViewID><TableID>olap_v_fact_avis</TableID></Source><StorageMode>Molap</StorageMode><ProcessingMode>Regular</ProcessingMode></Partition></Partitions></MeasureGroup></MeasureGroups><Source><DataSourceViewID>TuniShop</DataSourceViewID></Source></Cube><Cube ><ID>Marketing Clients</ID><Name>Marketing Clients</Name><Language>1036</Language><Collation>Latin1_General_CI_AS</Collation><Dimensions><Dimension><ID>Date</ID><Name>Date</Name><DimensionID>Date</DimensionID><Attributes><Attribute><AttributeID>Jour</AttributeID></Attribute><Attribute><AttributeID>Mois</AttributeID></Attribute><Attribute><AttributeID>Trimestre</AttributeID></Attribute><Attribute><AttributeID>Semestre</AttributeID></Attribute><Attribute><AttributeID>Annee</AttributeID></Attribute><Attribute><AttributeID>Jour Semaine</AttributeID></Attribute><Attribute><AttributeID>Periode Commerciale</AttributeID></Attribute><Attribute><AttributeID>Ramadan</AttributeID></Attribute><Attribute><AttributeID>Jour Ferie</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Calendrier</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Campagne</ID><Name>Campagne</Name><DimensionID>Campagne</DimensionID><Attributes><Attribute><AttributeID>Campagne</AttributeID></Attribute><Attribute><AttributeID>Canal Media</AttributeID></Attribute><Attribute><AttributeID>Type Canal</AttributeID></Attribute><Attribute><AttributeID>Objectif</AttributeID></Attribute><Attribute><AttributeID>Theme</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Medias</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Client</ID><Name>Client</Name><DimensionID>Client</DimensionID><Attributes><Attribute><AttributeID>Client</AttributeID></Attribute><Attribute><AttributeID>Gouvernorat</AttributeID></Attribute><Attribute><AttributeID>Region</AttributeID></Attribute><Attribute><AttributeID>Segment Fidelite</AttributeID></Attribute><Attribute><AttributeID>Type Client</AttributeID></Attribute><Attribute><AttributeID>Tranche Age</AttributeID></Attribute><Attribute><AttributeID>Canal Inscription</AttributeID></Attribute><Attribute><AttributeID>Cohorte Inscription</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Geographie Client</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Geographie</ID><Name>Géographie</Name><DimensionID>Geographie</DimensionID><Attributes><Attribute><AttributeID>Gouvernorat</AttributeID></Attribute><Attribute><AttributeID>Region</AttributeID></Attribute><Attribute><AttributeID>Zone Livraison</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Regions</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Canal</ID><Name>Canal</Name><DimensionID>Canal</DimensionID><Attributes><Attribute><AttributeID>Canal Appareil</AttributeID></Attribute><Attribute><AttributeID>Canal</AttributeID></Attribute><Attribute><AttributeID>Appareil</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Canaux</HierarchyID></Hierarchy></Hierarchies></Dimension><Dimension><ID>Statut Commande</ID><Name>Statut Commande</Name><DimensionID>Statut Commande</DimensionID><Attributes><Attribute><AttributeID>Libelle</AttributeID></Attribute><Attribute><AttributeID>Famille Statut</AttributeID></Attribute><Attribute><AttributeID>Statut</AttributeID></Attribute></Attributes><Hierarchies><Hierarchy><HierarchyID>Familles</HierarchyID></Hierarchy></Hierarchies></Dimension></Dimensions><MdxScripts><MdxScript><ID>MdxScript</ID><Name>MdxScript</Name><Commands><Command><Text>/* =====================================================================
   11e_Calculs_Cube_Marketing_Clients.mdx — TuniShop — script de calcul du cube [Marketing Clients]
   ---------------------------------------------------------------------
   Cube 5 — Marketing et clients : campagnes, acquisition, fidélisation.
   Où le coller : Visual Studio → cube Marketing Clients → onglet « Calculs »
   → « Affichage du script » → Ctrl+A → coller → Ctrl+S → Déployer.
   Mesures de base attendues dans ce cube : groupes Marketing (Depense HT, Impressions, Clics, Commandes Attribuees, Nouveaux Clients Attribues, CA Attribue TTC), Commandes (Nb Commandes, Montant Total TTC, Nb Premieres Commandes) et Clients distincts (Nb Clients)
   Règles : Dictionnaire_KPI.xlsx (partie 4). Divisions protégées (NULL si dénominateur vide).
   ===================================================================== */
CALCULATE;

CREATE MEMBER CURRENTCUBE.[Measures].[CPC] AS
    IIF([Measures].[Clics] = 0, NULL, [Measures].[Depense HT] / [Measures].[Clics]),
    FORMAT_STRING = "0.000", DISPLAY_FOLDER = 'KPI\Marketing', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[CPM] AS
    IIF([Measures].[Impressions] = 0, NULL, [Measures].[Depense HT] * 1000 / [Measures].[Impressions]),
    FORMAT_STRING = "0.000", DISPLAY_FOLDER = 'KPI\Marketing', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Taux Clic] AS
    IIF([Measures].[Impressions] = 0, NULL, [Measures].[Clics] / [Measures].[Impressions]),
    FORMAT_STRING = "0.000%", DISPLAY_FOLDER = 'KPI\Marketing', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Taux Conversion] AS
    IIF([Measures].[Clics] = 0, NULL, [Measures].[Commandes Attribuees] / [Measures].[Clics]),
    FORMAT_STRING = "0.000%", DISPLAY_FOLDER = 'KPI\Marketing', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[CAC] AS
    IIF([Measures].[Nouveaux Clients Attribues] = 0, NULL, [Measures].[Depense HT] / [Measures].[Nouveaux Clients Attribues]),
    FORMAT_STRING = "#,##0.00", DISPLAY_FOLDER = 'KPI\Marketing', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[ROAS] AS
    IIF([Measures].[Depense HT] = 0, NULL, [Measures].[CA Attribue TTC] / [Measures].[Depense HT]),
    FORMAT_STRING = "0.000", DISPLAY_FOLDER = 'KPI\Marketing', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[CA Reconnu TTC] AS
    ([Measures].[Montant Total TTC], [Statut Commande].[Famille Statut].&amp;[aboutie]),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;

-- Clients actifs = clients distincts, hors commandes en échec de paiement
CREATE MEMBER CURRENTCUBE.[Measures].[Clients Actifs] AS
    Aggregate(
        Except([Statut Commande].[Statut].[Statut].MEMBERS, { [Statut Commande].[Statut].&amp;[paiement_echoue] }),
        [Measures].[Nb Clients]),
    FORMAT_STRING = "#,##0", DISPLAY_FOLDER = 'KPI\Clients', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Nouveaux Clients] AS
    [Measures].[Nb Premieres Commandes],
    FORMAT_STRING = "#,##0", DISPLAY_FOLDER = 'KPI\Clients', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[CA Par Client Actif] AS
    IIF([Measures].[Clients Actifs] = 0, NULL, [Measures].[CA Reconnu TTC] / [Measures].[Clients Actifs]),
    FORMAT_STRING = "#,##0.00", DISPLAY_FOLDER = 'KPI\Clients', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Commandes Hors Echec Paiement] AS
    Aggregate(
        Except([Statut Commande].[Statut].[Statut].MEMBERS, { [Statut Commande].[Statut].&amp;[paiement_echoue] }),
        [Measures].[Nb Commandes]),
    FORMAT_STRING = "#,##0", DISPLAY_FOLDER = 'KPI\Clients', VISIBLE = 0;

-- Clients ayant passé au moins 2 commandes (hors échec de paiement) sur la période affichée
CREATE MEMBER CURRENTCUBE.[Measures].[Clients Fideles] AS
    Count(Filter(EXISTING [Client].[Client].[Client].MEMBERS,
                 [Measures].[Commandes Hors Echec Paiement] &gt;= 2)),
    FORMAT_STRING = "#,##0", DISPLAY_FOLDER = 'KPI\Clients', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Taux Reachat] AS
    IIF([Measures].[Clients Actifs] = 0, NULL, [Measures].[Clients Fideles] / [Measures].[Clients Actifs]),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Clients', VISIBLE = 1;
