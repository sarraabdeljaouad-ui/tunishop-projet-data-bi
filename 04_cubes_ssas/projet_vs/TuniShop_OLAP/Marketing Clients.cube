        IIF([Measures].[Evolution CA Par Client Actif] &gt; 0.02, 1, IIF([Measures].[Evolution CA Par Client Actif] &lt; -0.02, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'Comparaison\Feux', VISIBLE = 1;
