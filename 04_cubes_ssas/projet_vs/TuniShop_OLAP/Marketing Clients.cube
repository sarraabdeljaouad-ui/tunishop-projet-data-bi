    IIF(IsEmpty([Measures].[Evolution Clients Fideles]), NULL,
        IIF([Measures].[Evolution Clients Fideles] &gt; 0.02, 1, IIF([Measures].[Evolution Clients Fideles] &lt; -0.02, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'Comparaison\Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Statut Taux Reachat] AS
    IIF(IsEmpty([Measures].[Ecart Taux Reachat]), NULL,
        IIF([Measures].[Ecart Taux Reachat] &gt; 0.5, 1, IIF([Measures].[Ecart Taux Reachat] &lt; -0.5, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'Comparaison\Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Couleur ROAS] AS
    IIF(IsEmpty([Measures].[Statut ROAS]), "#5B6B7C",
        IIF([Measures].[Statut ROAS] = 1, "#1E7B4F", IIF([Measures].[Statut ROAS] = -1, "#B42318", "#5B6B7C"))),
    DISPLAY_FOLDER = 'Comparaison\Feux', VISIBLE = 1;
