    IIF(IsEmpty([Measures].[Evolution Nouveaux Clients]), NULL,
        IIF([Measures].[Evolution Nouveaux Clients] &gt; 0.02, 1, IIF([Measures].[Evolution Nouveaux Clients] &lt; -0.02, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'Comparaison\Feux', VISIBLE = 1;
