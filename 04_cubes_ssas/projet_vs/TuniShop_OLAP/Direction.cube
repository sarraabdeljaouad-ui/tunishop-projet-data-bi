          <Attributes>
            <Attribute dwd:design-time-name="bc11e1af-e389-42e8-b20b-e1a28070676b">
              <AttributeID>Jour</AttributeID>
              <KeyColumns>
                <KeyColumn dwd:design-time-name="629b1f06-94a6-49bf-9aa2-a667b5391381">
                  <DataType>Integer</DataType>
                  <Source xsi:type="ColumnBinding" dwd:design-time-name="bc1e99bf-f128-46df-992f-9ecc5ca388bc">
                    <TableID>olap_v_fact_marketing_quotidien</TableID>
