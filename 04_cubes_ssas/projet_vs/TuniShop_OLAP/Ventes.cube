    IIF(IsEmpty([Measures].[Statut CA Commande TTC]), "#5B6B7C",
        IIF([Measures].[Statut CA Commande TTC] = 1, "#1E7B4F", IIF([Measures].[Statut CA Commande TTC] = -1, "#B42318", "#5B6B7C"))),
    DISPLAY_FOLDER = 'Comparaison\Feux', VISIBLE = 1;
