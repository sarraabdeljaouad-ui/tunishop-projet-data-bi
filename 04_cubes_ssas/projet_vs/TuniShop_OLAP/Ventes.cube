  <Source dwd:design-time-name="767b8e86-9d95-497e-9c69-8840f96a40a5">
    <DataSourceViewID>TuniShop</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="f71beb42-eb54-4d68-bebf-3a31117af0f9">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/* =====================================================================
   11a_Calculs_Cube_Ventes.mdx — TuniShop — script de calcul du cube [Ventes]
   ---------------------------------------------------------------------
   Cube 1 — Ventes : chiffre d'affaires, marge, panier, canaux, annulations, paiements.
   Où le coller : Visual Studio → cube Ventes → onglet « Calculs »
   → « Affichage du script » → Ctrl+A → coller → Ctrl+S → Déployer.
   Mesures de base attendues dans ce cube : groupes Ventes, Commandes, Paiements (Nb Lignes Vente, Montant Total TTC, Nb Commandes, Montant Ligne HT, Marge Brute HT, Montant Brut TTC, Remise Promo TTC, Nb Articles, Montant Rembourse Commande TTC, Nb Tentatives Paiement, Nb Paiements Reussis…)
   Règles : Dictionnaire_KPI.xlsx (partie 4). Divisions protégées (NULL si dénominateur vide).
   ===================================================================== */
CALCULATE;
CREATE MEMBER CURRENTCUBE.[Measures].[CA Commande TTC] AS
    [Measures].[Montant Total TTC],
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Commandes Passees] AS
    [Measures].[Nb Commandes],
    FORMAT_STRING = "#,##0", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[CA Reconnu TTC] AS
    ([Measures].[Montant Total TTC], [Statut Commande].[Famille Statut].&amp;[aboutie]),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Commandes Reconnues] AS
    ([Measures].[Nb Commandes], [Statut Commande].[Famille Statut].&amp;[aboutie]),
    FORMAT_STRING = "#,##0", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Rembourse TTC] AS
    ([Measures].[Montant Rembourse Commande TTC], [Statut Commande].[Famille Statut].&amp;[aboutie]),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[CA Net TTC] AS
    [Measures].[CA Reconnu TTC] - [Measures].[Rembourse TTC],
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[CA HT Reconnu] AS
    ([Measures].[Montant Ligne HT], [Statut Commande].[Famille Statut].&amp;[aboutie]),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Marge Brute Reconnue HT] AS
    ([Measures].[Marge Brute HT], [Statut Commande].[Famille Statut].&amp;[aboutie]),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Taux Marge Brute] AS
    IIF([Measures].[CA HT Reconnu] = 0, NULL, [Measures].[Marge Brute Reconnue HT] / [Measures].[CA HT Reconnu]),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Panier Moyen TTC] AS
    IIF([Measures].[Commandes Reconnues] = 0, NULL, [Measures].[CA Reconnu TTC] / [Measures].[Commandes Reconnues]),
    FORMAT_STRING = "#,##0.00", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Articles Par Commande] AS
    IIF([Measures].[Commandes Reconnues] = 0, NULL,
        ([Measures].[Nb Articles], [Statut Commande].[Famille Statut].&amp;[aboutie]) / [Measures].[Commandes Reconnues]),
    FORMAT_STRING = "0.000", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Taux Remise Produit] AS
    IIF(([Measures].[Montant Brut TTC], [Statut Commande].[Famille Statut].&amp;[aboutie]) = 0, NULL,
        ([Measures].[Remise Promo TTC], [Statut Commande].[Famille Statut].&amp;[aboutie])
        / ([Measures].[Montant Brut TTC], [Statut Commande].[Famille Statut].&amp;[aboutie])),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;
-- Parts : numérateur = un canal / un mode ; dénominateur = tous les canaux / tous les modes
CREATE MEMBER CURRENTCUBE.[Measures].[Part Application Mobile] AS
    IIF(([Measures].[Nb Commandes], [Canal].[Canal].[All]) = 0, NULL,
        ([Measures].[Nb Commandes], [Canal].[Canal].&amp;[application_mobile])
        / ([Measures].[Nb Commandes], [Canal].[Canal].[All])),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Part Paiement A La Livraison] AS
    IIF(([Measures].[Nb Commandes], [Mode Paiement].[Mode Paiement].[All]) = 0, NULL,
        ([Measures].[Nb Commandes], [Mode Paiement].[Mode Paiement].&amp;[paiement_a_la_livraison])
        / ([Measures].[Nb Commandes], [Mode Paiement].[Mode Paiement].[All])),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Ventes', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Taux Annulation] AS
    IIF(([Measures].[Nb Commandes], Root([Statut Commande])) = 0, NULL,
        ([Measures].[Nb Commandes], [Statut Commande].[Statut].&amp;[annulee])
        / ([Measures].[Nb Commandes], Root([Statut Commande]))),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Operations', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Taux Refus Colis] AS
    IIF(([Measures].[Nb Commandes], [Statut Commande].[Famille Statut].&amp;[aboutie])
        + ([Measures].[Nb Commandes], [Statut Commande].[Statut].&amp;[livraison_echouee]) = 0, NULL,
        ([Measures].[Nb Commandes], [Statut Commande].[Statut].&amp;[livraison_echouee])
        / (([Measures].[Nb Commandes], [Statut Commande].[Famille Statut].&amp;[aboutie])
           + ([Measures].[Nb Commandes], [Statut Commande].[Statut].&amp;[livraison_echouee]))),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Operations', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Taux Echec Paiement] AS
    IIF([Measures].[Nb Tentatives Paiement] = 0, NULL,
        1 - [Measures].[Nb Paiements Reussis] / [Measures].[Nb Tentatives Paiement]),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'KPI\Operations', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[CA Reconnu A-1] AS
    ([Measures].[CA Reconnu TTC],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI\Temps', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Evolution CA Reconnu] AS
    IIF(IsEmpty([Measures].[CA Reconnu TTC]) OR IsEmpty([Measures].[CA Reconnu A-1]) OR [Measures].[CA Reconnu A-1] = 0, NULL,
        ([Measures].[CA Reconnu TTC] - [Measures].[CA Reconnu A-1]) / [Measures].[CA Reconnu A-1]),
    FORMAT_STRING = "0.0%", DISPLAY_FOLDER = 'KPI\Temps', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[CA Reconnu Cumul Annuel] AS
    Sum(PeriodsToDate([Date].[Calendrier].[Année], [Date].[Calendrier].CurrentMember),
        [Measures].[CA Reconnu TTC]),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'KPI\Temps', VISIBLE = 1;

/* =====================================================================
   v2 (29/10/2026) — comparaison à l'année précédente et feux de tendance (même règle que le cube Direction)
   A-1 : même KPI sur la période parallèle de l'année précédente (hiérarchie Calendrier).
   Evolution : variation relative ; Ecart : différence en points de pourcentage (taux).
   Statut : 1 favorable, 0 stable (|évolution| &lt; 2 % ou |écart| &lt; 0,5 point), -1 défavorable ; NULL sans année précédente.
   Couleur : #1E7B4F, #5B6B7C, #B42318. Pas de feu pour les KPI sans sens favorable (volumes, parts, remises, valeur du stock).
   ===================================================================== */

/* ---------- Année précédente ---------- */
CREATE MEMBER CURRENTCUBE.[Measures].[CA Commande TTC A-1] AS
    ([Measures].[CA Commande TTC],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'Comparaison\Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[CA Net TTC A-1] AS
    ([Measures].[CA Net TTC],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'Comparaison\Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Commandes Reconnues A-1] AS
    ([Measures].[Commandes Reconnues],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "#,##0", DISPLAY_FOLDER = 'Comparaison\Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Panier Moyen TTC A-1] AS
    ([Measures].[Panier Moyen TTC],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "#,##0.00", DISPLAY_FOLDER = 'Comparaison\Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Articles Par Commande A-1] AS
    ([Measures].[Articles Par Commande],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "0.000", DISPLAY_FOLDER = 'Comparaison\Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[CA HT Reconnu A-1] AS
    ([Measures].[CA HT Reconnu],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'Comparaison\Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Marge Brute Reconnue HT A-1] AS
    ([Measures].[Marge Brute Reconnue HT],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "#,##0.000", DISPLAY_FOLDER = 'Comparaison\Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Taux Marge Brute A-1] AS
    ([Measures].[Taux Marge Brute],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'Comparaison\Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Taux Remise Produit A-1] AS
    ([Measures].[Taux Remise Produit],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
