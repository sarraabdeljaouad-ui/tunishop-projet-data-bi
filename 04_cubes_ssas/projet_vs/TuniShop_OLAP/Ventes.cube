CREATE MEMBER CURRENTCUBE.[Measures].[Taux Annulation A-1] AS
    ([Measures].[Taux Annulation],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'Comparaison\Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Taux Refus Colis A-1] AS
    ([Measures].[Taux Refus Colis],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'Comparaison\Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Taux Echec Paiement A-1] AS
    ([Measures].[Taux Echec Paiement],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'Comparaison\Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Part Paiement A La Livraison A-1] AS
    ([Measures].[Part Paiement A La Livraison],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'Comparaison\Année précédente', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Part Application Mobile A-1] AS
    ([Measures].[Part Application Mobile],
     ParallelPeriod([Date].[Calendrier].[Année], 1, [Date].[Calendrier].CurrentMember)),
    FORMAT_STRING = "0.00%", DISPLAY_FOLDER = 'Comparaison\Année précédente', VISIBLE = 1;

/* ---------- Évolutions et écarts ---------- */
CREATE MEMBER CURRENTCUBE.[Measures].[Evolution CA Commande TTC] AS
    IIF(IsEmpty([Measures].[CA Commande TTC]) OR IsEmpty([Measures].[CA Commande TTC A-1]) OR [Measures].[CA Commande TTC A-1] = 0, NULL,
        ([Measures].[CA Commande TTC] - [Measures].[CA Commande TTC A-1]) / [Measures].[CA Commande TTC A-1]),
    FORMAT_STRING = "+0.0%;-0.0%;0.0%", DISPLAY_FOLDER = 'Comparaison\Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Evolution CA Net TTC] AS
    IIF(IsEmpty([Measures].[CA Net TTC]) OR IsEmpty([Measures].[CA Net TTC A-1]) OR [Measures].[CA Net TTC A-1] = 0, NULL,
        ([Measures].[CA Net TTC] - [Measures].[CA Net TTC A-1]) / [Measures].[CA Net TTC A-1]),
    FORMAT_STRING = "+0.0%;-0.0%;0.0%", DISPLAY_FOLDER = 'Comparaison\Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Evolution Commandes Reconnues] AS
    IIF(IsEmpty([Measures].[Commandes Reconnues]) OR IsEmpty([Measures].[Commandes Reconnues A-1]) OR [Measures].[Commandes Reconnues A-1] = 0, NULL,
        ([Measures].[Commandes Reconnues] - [Measures].[Commandes Reconnues A-1]) / [Measures].[Commandes Reconnues A-1]),
    FORMAT_STRING = "+0.0%;-0.0%;0.0%", DISPLAY_FOLDER = 'Comparaison\Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Evolution Panier Moyen] AS
    IIF(IsEmpty([Measures].[Panier Moyen TTC]) OR IsEmpty([Measures].[Panier Moyen TTC A-1]) OR [Measures].[Panier Moyen TTC A-1] = 0, NULL,
        ([Measures].[Panier Moyen TTC] - [Measures].[Panier Moyen TTC A-1]) / [Measures].[Panier Moyen TTC A-1]),
    FORMAT_STRING = "+0.0%;-0.0%;0.0%", DISPLAY_FOLDER = 'Comparaison\Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Evolution Articles Par Commande] AS
    IIF(IsEmpty([Measures].[Articles Par Commande]) OR IsEmpty([Measures].[Articles Par Commande A-1]) OR [Measures].[Articles Par Commande A-1] = 0, NULL,
        ([Measures].[Articles Par Commande] - [Measures].[Articles Par Commande A-1]) / [Measures].[Articles Par Commande A-1]),
    FORMAT_STRING = "+0.0%;-0.0%;0.0%", DISPLAY_FOLDER = 'Comparaison\Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Evolution CA HT Reconnu] AS
    IIF(IsEmpty([Measures].[CA HT Reconnu]) OR IsEmpty([Measures].[CA HT Reconnu A-1]) OR [Measures].[CA HT Reconnu A-1] = 0, NULL,
        ([Measures].[CA HT Reconnu] - [Measures].[CA HT Reconnu A-1]) / [Measures].[CA HT Reconnu A-1]),
    FORMAT_STRING = "+0.0%;-0.0%;0.0%", DISPLAY_FOLDER = 'Comparaison\Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Evolution Marge Brute Reconnue HT] AS
    IIF(IsEmpty([Measures].[Marge Brute Reconnue HT]) OR IsEmpty([Measures].[Marge Brute Reconnue HT A-1]) OR [Measures].[Marge Brute Reconnue HT A-1] = 0, NULL,
        ([Measures].[Marge Brute Reconnue HT] - [Measures].[Marge Brute Reconnue HT A-1]) / [Measures].[Marge Brute Reconnue HT A-1]),
    FORMAT_STRING = "+0.0%;-0.0%;0.0%", DISPLAY_FOLDER = 'Comparaison\Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Ecart Taux Marge Brute] AS
    IIF(IsEmpty([Measures].[Taux Marge Brute]) OR IsEmpty([Measures].[Taux Marge Brute A-1]), NULL,
        ([Measures].[Taux Marge Brute] - [Measures].[Taux Marge Brute A-1]) * 100),
    FORMAT_STRING = "+0.00;-0.00;0.00", DISPLAY_FOLDER = 'Comparaison\Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Ecart Taux Remise Produit] AS
    IIF(IsEmpty([Measures].[Taux Remise Produit]) OR IsEmpty([Measures].[Taux Remise Produit A-1]), NULL,
        ([Measures].[Taux Remise Produit] - [Measures].[Taux Remise Produit A-1]) * 100),
    FORMAT_STRING = "+0.00;-0.00;0.00", DISPLAY_FOLDER = 'Comparaison\Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Ecart Taux Annulation] AS
    IIF(IsEmpty([Measures].[Taux Annulation]) OR IsEmpty([Measures].[Taux Annulation A-1]), NULL,
        ([Measures].[Taux Annulation] - [Measures].[Taux Annulation A-1]) * 100),
    FORMAT_STRING = "+0.00;-0.00;0.00", DISPLAY_FOLDER = 'Comparaison\Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Ecart Taux Refus Colis] AS
    IIF(IsEmpty([Measures].[Taux Refus Colis]) OR IsEmpty([Measures].[Taux Refus Colis A-1]), NULL,
        ([Measures].[Taux Refus Colis] - [Measures].[Taux Refus Colis A-1]) * 100),
    FORMAT_STRING = "+0.00;-0.00;0.00", DISPLAY_FOLDER = 'Comparaison\Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Ecart Taux Echec Paiement] AS
    IIF(IsEmpty([Measures].[Taux Echec Paiement]) OR IsEmpty([Measures].[Taux Echec Paiement A-1]), NULL,
        ([Measures].[Taux Echec Paiement] - [Measures].[Taux Echec Paiement A-1]) * 100),
    FORMAT_STRING = "+0.00;-0.00;0.00", DISPLAY_FOLDER = 'Comparaison\Evolutions', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Ecart Part Paiement A La Livraison] AS
    IIF(IsEmpty([Measures].[Part Paiement A La Livraison]) OR IsEmpty([Measures].[Part Paiement A La Livraison A-1]), NULL,
        ([Measures].[Part Paiement A La Livraison] - [Measures].[Part Paiement A La Livraison A-1]) * 100),
