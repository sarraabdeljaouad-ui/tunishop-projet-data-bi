        IIF([Measures].[Ecart Taux Echec Paiement] &gt; 0.5, -1, IIF([Measures].[Ecart Taux Echec Paiement] &lt; -0.5, 1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'Comparaison\Feux', VISIBLE = 1;
