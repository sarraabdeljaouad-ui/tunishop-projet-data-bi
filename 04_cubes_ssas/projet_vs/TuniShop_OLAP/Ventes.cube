CREATE MEMBER CURRENTCUBE.[Measures].[Ecart Part Application Mobile] AS
    IIF(IsEmpty([Measures].[Part Application Mobile]) OR IsEmpty([Measures].[Part Application Mobile A-1]), NULL,
        ([Measures].[Part Application Mobile] - [Measures].[Part Application Mobile A-1]) * 100),
    FORMAT_STRING = "+0.00;-0.00;0.00", DISPLAY_FOLDER = 'Comparaison\Evolutions', VISIBLE = 1;

/* ---------- Feux de tendance ---------- */
CREATE MEMBER CURRENTCUBE.[Measures].[Statut CA Commande TTC] AS
    IIF(IsEmpty([Measures].[Evolution CA Commande TTC]), NULL,
        IIF([Measures].[Evolution CA Commande TTC] &gt; 0.02, 1, IIF([Measures].[Evolution CA Commande TTC] &lt; -0.02, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'Comparaison\Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Statut CA Reconnu] AS
    IIF(IsEmpty([Measures].[Evolution CA Reconnu]), NULL,
        IIF([Measures].[Evolution CA Reconnu] &gt; 0.02, 1, IIF([Measures].[Evolution CA Reconnu] &lt; -0.02, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'Comparaison\Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Statut CA Net TTC] AS
    IIF(IsEmpty([Measures].[Evolution CA Net TTC]), NULL,
        IIF([Measures].[Evolution CA Net TTC] &gt; 0.02, 1, IIF([Measures].[Evolution CA Net TTC] &lt; -0.02, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'Comparaison\Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Statut Commandes Reconnues] AS
    IIF(IsEmpty([Measures].[Evolution Commandes Reconnues]), NULL,
        IIF([Measures].[Evolution Commandes Reconnues] &gt; 0.02, 1, IIF([Measures].[Evolution Commandes Reconnues] &lt; -0.02, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'Comparaison\Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Statut Panier Moyen] AS
    IIF(IsEmpty([Measures].[Evolution Panier Moyen]), NULL,
        IIF([Measures].[Evolution Panier Moyen] &gt; 0.02, 1, IIF([Measures].[Evolution Panier Moyen] &lt; -0.02, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'Comparaison\Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Statut Articles Par Commande] AS
    IIF(IsEmpty([Measures].[Evolution Articles Par Commande]), NULL,
        IIF([Measures].[Evolution Articles Par Commande] &gt; 0.02, 1, IIF([Measures].[Evolution Articles Par Commande] &lt; -0.02, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'Comparaison\Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Statut CA HT Reconnu] AS
    IIF(IsEmpty([Measures].[Evolution CA HT Reconnu]), NULL,
        IIF([Measures].[Evolution CA HT Reconnu] &gt; 0.02, 1, IIF([Measures].[Evolution CA HT Reconnu] &lt; -0.02, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'Comparaison\Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Statut Marge Brute Reconnue HT] AS
    IIF(IsEmpty([Measures].[Evolution Marge Brute Reconnue HT]), NULL,
        IIF([Measures].[Evolution Marge Brute Reconnue HT] &gt; 0.02, 1, IIF([Measures].[Evolution Marge Brute Reconnue HT] &lt; -0.02, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'Comparaison\Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Statut Taux Marge Brute] AS
    IIF(IsEmpty([Measures].[Ecart Taux Marge Brute]), NULL,
        IIF([Measures].[Ecart Taux Marge Brute] &gt; 0.5, 1, IIF([Measures].[Ecart Taux Marge Brute] &lt; -0.5, -1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'Comparaison\Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Statut Taux Annulation] AS
    IIF(IsEmpty([Measures].[Ecart Taux Annulation]), NULL,
        IIF([Measures].[Ecart Taux Annulation] &gt; 0.5, -1, IIF([Measures].[Ecart Taux Annulation] &lt; -0.5, 1, 0))),
    FORMAT_STRING = "0", DISPLAY_FOLDER = 'Comparaison\Feux', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Statut Taux Refus Colis] AS
    IIF(IsEmpty([Measures].[Ecart Taux Refus Colis]), NULL,
        IIF([Measures].[Ecart Taux Refus Colis] &gt; 0.5, -1, IIF([Measures].[Ecart Taux Refus Colis] &lt; -0.5, 1, 0))),
