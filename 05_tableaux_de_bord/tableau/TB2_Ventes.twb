      </column>
      <column caption="Taux de remise produit N" datatype="real" name="[Calculation_37700055]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF [annee] = [Parameters].[Parameter 1] THEN [remise_promo_reconnue_ttc] END) / SUM(IF [annee] = [Parameters].[Parameter 1] THEN [brut_reconnu_ttc] END)"/>
      </column>
      <column caption="Taux de remise produit N-1" datatype="real" name="[Calculation_37700056]" role="measure" type="quantitative">
