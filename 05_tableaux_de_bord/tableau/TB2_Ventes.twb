            <column caption="Taux d'échec de paiement N" datatype="real" name="[Calculation_37700073]" role="measure" type="quantitative">
              <calculation class="tableau" formula="1 - SUM(IF [annee] = [Parameters].[Parameter 1] THEN [nb_paiements_reussis] END) / SUM(IF [annee] = [Parameters].[Parameter 1] THEN [nb_tentatives_paiement] END)"/>
            </column>
            <column caption="Taux d'échec de paiement N-1" datatype="real" name="[Calculation_37700074]" role="measure" type="quantitative">
              <calculation class="tableau" formula="1 - SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [nb_paiements_reussis] END) / SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [nb_tentatives_paiement] END)"/>
            </column>
            <column caption="Taux d'échec de paiement écart (pt)" datatype="real" name="[Calculation_37700075]" role="measure" type="quantitative">
              <calculation class="tableau" formula="([Calculation_37700073] - [Calculation_37700074]) * 100"/>
