        <calculation class="tableau" formula="IF ISNULL([Calculation_37700063]) THEN &quot;Pas d'année précédente&quot; ELSEIF ROUND([Calculation_37700063],2) = 0 THEN &quot;= 0 pt vs &quot; + STR([Parameters].[Parameter 1]-1) ELSE (IF ROUND([Calculation_37700063],2) &gt; 0 THEN &quot;▲ +&quot; ELSE &quot;▼ &quot; END) + REPLACE(STR(ROUND([Calculation_37700063],2)),&quot;.&quot;,&quot;,&quot;) + &quot; pt vs &quot; + STR([Parameters].[Parameter 1]-1) END"/>
      </column>
      <column caption="Taux de refus de colis N" datatype="real" name="[Calculation_37700067]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF [annee] = [Parameters].[Parameter 1] THEN [nb_cmd_livraison_echouee] END) / (SUM(IF [annee] = [Parameters].[Parameter 1] THEN [nb_cmd_reconnues] END) + SUM(IF [annee] = [Parameters].[Parameter 1] THEN [nb_cmd_livraison_echouee] END))"/>
      </column>
      <column caption="Taux de refus de colis N-1" datatype="real" name="[Calculation_37700068]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [nb_cmd_livraison_echouee] END) / (SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [nb_cmd_reconnues] END) + SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [nb_cmd_livraison_echouee] END))"/>
