            <column caption="Taux de marge brute N" datatype="real" name="[Calculation_37700049]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IF [annee] = [Parameters].[Parameter 1] THEN [marge_reconnue_ht] END) / SUM(IF [annee] = [Parameters].[Parameter 1] THEN [ca_ht_reconnu] END)"/>
            </column>
            <column caption="Taux de marge brute N-1" datatype="real" name="[Calculation_37700050]" role="measure" type="quantitative">
