            <datasource name="Parameters"/>
          </datasources>
          <datasource-dependencies datasource="Parameters">
            <column caption="Année analysée" datatype="integer" name="[Parameter 1]" param-domain-type="list" role="measure" type="quantitative" value="2025">
              <calculation class="tableau" formula="2025"/>
              <members>
                <member value="2023"/>
                <member value="2024"/>
                <member value="2025"/>
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="federated.tunishop0ventes0001">
            <column caption="Année" datatype="integer" name="[annee]" role="dimension" type="ordinal"/>
            <column caption="Mode de paiement" datatype="string" name="[mode_paiement]" role="dimension" type="nominal"/>
            <column caption="Nb cmd reconnues" datatype="real" name="[nb_cmd_reconnues]" role="measure" type="quantitative" default-format="n#,##0"/>
            <column caption="Nb cmd livraison echouee" datatype="real" name="[nb_cmd_livraison_echouee]" role="measure" type="quantitative" default-format="n#,##0"/>
            <column caption="Année N" datatype="boolean" name="[Calculation_37700091]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[annee] = [Parameters].[Parameter 1]"/>
            </column>
            <column caption="Taux de refus de colis (détail)" datatype="real" name="[Calculation_37700098]" role="measure" type="quantitative" default-format="p0.0%">
              <calculation class="tableau" formula="SUM([nb_cmd_livraison_echouee]) / (SUM([nb_cmd_reconnues]) + SUM([nb_cmd_livraison_echouee]))"/>
            </column>
            <column-instance column="[mode_paiement]" derivation="None" name="[none:mode_paiement:nk]" pivot="key" type="nominal"/>
            <column-instance column="[Calculation_37700098]" derivation="User" name="[usr:Calculation_37700098:qk]" pivot="key" type="quantitative"/>
            <column-instance column="[Calculation_37700091]" derivation="None" name="[none:Calculation_37700091:nk]" pivot="key" type="nominal"/>
