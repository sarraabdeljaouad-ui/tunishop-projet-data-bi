  <worksheets>
    <worksheet name="V-K01 CA commandé TTC">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#1f4e79" fontsize="9">CA commandé TTC</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="TuniShop Ventes (tab.v_ventes)" name="federated.tunishop0ventes0001"/>
            <datasource name="Parameters"/>
          </datasources>
          <datasource-dependencies datasource="Parameters">
            <column caption="Année analysée" datatype="integer" name="[Parameter 1]" param-domain-type="list" role="measure" type="quantitative" value="2025">
              <calculation class="tableau" formula="2025"/>
              <members>
                <member value="2023"/>
                <member value="2024"/>
                <member value="2025"/>
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="federated.tunishop0ventes0001">
            <column caption="Année" datatype="integer" name="[annee]" role="dimension" type="ordinal"/>
            <column caption="CA commande TTC" datatype="real" name="[ca_commande_ttc]" role="measure" type="quantitative" default-format="n#,##0"/>
            <column caption="CA commandé TTC N" datatype="real" name="[Calculation_37700001]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IF [annee] = [Parameters].[Parameter 1] THEN [ca_commande_ttc] END)"/>
            </column>
            <column caption="CA commandé TTC N-1" datatype="real" name="[Calculation_37700002]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [ca_commande_ttc] END)"/>
            </column>
            <column caption="CA commandé TTC évolution" datatype="real" name="[Calculation_37700003]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF [Calculation_37700002] = 0 THEN NULL ELSE ([Calculation_37700001] - [Calculation_37700002]) / [Calculation_37700002] END"/>
            </column>
            <column caption="CA commandé TTC statut" datatype="string" name="[Calculation_37700004]" role="measure" type="nominal">
              <calculation class="tableau" formula="IF ISNULL([Calculation_37700003]) THEN &quot;Sans comparaison&quot; ELSEIF ABS([Calculation_37700003]) &lt; 0.02 THEN &quot;Stable&quot; ELSEIF [Calculation_37700003] * (1) &gt; 0 THEN &quot;Favorable&quot; ELSE &quot;Défavorable&quot; END"/>
            </column>
            <column caption="CA commandé TTC valeur (texte)" datatype="string" name="[Calculation_37700005]" role="measure" type="nominal">
              <calculation class="tableau" formula="REPLACE(STR(ROUND(([Calculation_37700001])/1000000,2)),&quot;.&quot;,&quot;,&quot;) + &quot; M TND&quot;"/>
            </column>
            <column caption="CA commandé TTC évolution (texte)" datatype="string" name="[Calculation_37700006]" role="measure" type="nominal">
              <calculation class="tableau" formula="IF ISNULL([Calculation_37700003]) THEN &quot;Pas d'année précédente&quot; ELSEIF ROUND([Calculation_37700003]*100,1) = 0 THEN &quot;= 0 % vs &quot; + STR([Parameters].[Parameter 1]-1) ELSE (IF ROUND([Calculation_37700003]*100,1) &gt; 0 THEN &quot;▲ +&quot; ELSE &quot;▼ &quot; END) + REPLACE(STR(ROUND([Calculation_37700003]*100,1)),&quot;.&quot;,&quot;,&quot;) + &quot; % vs &quot; + STR([Parameters].[Parameter 1]-1) END"/>
            </column>
            <column-instance column="[Calculation_37700005]" derivation="User" name="[usr:Calculation_37700005:nk]" pivot="key" type="nominal"/>
            <column-instance column="[Calculation_37700006]" derivation="User" name="[usr:Calculation_37700006:nk]" pivot="key" type="nominal"/>
            <column-instance column="[Calculation_37700004]" derivation="User" name="[usr:Calculation_37700004:nk]" pivot="key" type="nominal"/>
          </datasource-dependencies>
          <aggregation value="true"/>
        </view>
        <style/>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto"/>
            </view>
            <mark class="Text"/>
            <encodings>
              <color column="[federated.tunishop0ventes0001].[usr:Calculation_37700004:nk]"/>
              <text column="[federated.tunishop0ventes0001].[usr:Calculation_37700005:nk]"/>
              <text column="[federated.tunishop0ventes0001].[usr:Calculation_37700006:nk]"/>
            </encodings>
            <customized-label>
              <formatted-text>
                <run bold="true" fontsize="15">&lt;[federated.tunishop0ventes0001].[usr:Calculation_37700005:nk]&gt;</run>
