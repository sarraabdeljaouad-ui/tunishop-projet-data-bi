        <calculation class="tableau" formula="IF ISNULL([Calculation_37700063]) THEN &quot;Sans comparaison&quot; ELSEIF ABS([Calculation_37700063]) &lt; 0.5 THEN &quot;Stable&quot; ELSEIF [Calculation_37700063] * (-1) &gt; 0 THEN &quot;Favorable&quot; ELSE &quot;Défavorable&quot; END"/>
