        <calculation class="tableau" formula="SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [marge_reconnue_ht] END) / SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [ca_ht_reconnu] END)"/>
      </column>
      <column caption="Taux de marge brute écart (pt)" datatype="real" name="[Calculation_37700051]" role="measure" type="quantitative">
        <calculation class="tableau" formula="([Calculation_37700049] - [Calculation_37700050]) * 100"/>
      </column>
      <column caption="Taux de marge brute statut" datatype="string" name="[Calculation_37700052]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF ISNULL([Calculation_37700051]) THEN &quot;Sans comparaison&quot; ELSEIF ABS([Calculation_37700051]) &lt; 0.5 THEN &quot;Stable&quot; ELSEIF [Calculation_37700051] * (1) &gt; 0 THEN &quot;Favorable&quot; ELSE &quot;Défavorable&quot; END"/>
      </column>
      <column caption="Taux de marge brute valeur (texte)" datatype="string" name="[Calculation_37700053]" role="measure" type="nominal">
        <calculation class="tableau" formula="REPLACE(STR(ROUND(([Calculation_37700049])*100,2)),&quot;.&quot;,&quot;,&quot;) + &quot; %&quot;"/>
      </column>
