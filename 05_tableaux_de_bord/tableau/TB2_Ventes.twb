        <calculation class="tableau" formula="IF ISNULL([Calculation_37700057]) THEN &quot;Pas d'année précédente&quot; ELSEIF ROUND([Calculation_37700057],2) = 0 THEN &quot;= 0 pt vs &quot; + STR([Parameters].[Parameter 1]-1) ELSE (IF ROUND([Calculation_37700057],2) &gt; 0 THEN &quot;▲ +&quot; ELSE &quot;▼ &quot; END) + REPLACE(STR(ROUND([Calculation_37700057],2)),&quot;.&quot;,&quot;,&quot;) + &quot; pt vs &quot; + STR([Parameters].[Parameter 1]-1) END"/>
      </column>
      <column caption="Taux d'annulation N" datatype="real" name="[Calculation_37700061]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF [annee] = [Parameters].[Parameter 1] THEN [nb_cmd_annulees] END) / SUM(IF [annee] = [Parameters].[Parameter 1] THEN [nb_commandes] END)"/>
      </column>
      <column caption="Taux d'annulation N-1" datatype="real" name="[Calculation_37700062]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [nb_cmd_annulees] END) / SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [nb_commandes] END)"/>
      </column>
