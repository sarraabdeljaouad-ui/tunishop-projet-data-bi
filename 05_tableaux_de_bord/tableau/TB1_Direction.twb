    <worksheet name='D-K02 Taux de marge brute'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1f4e79' fontsize='9'>Taux de marge brute</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='TuniShop Direction (tab.v_direction)' name='federated.tunishop0direction01' />
            <datasource caption='Paramètres' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Année analysée' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2025'>
              <calculation class='tableau' formula='2025' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.tunishop0direction01'>
            <column caption='Taux de marge brute N' datatype='real' name='[Calculation_39740009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [annee] = [Parameters].[Parameter 1] THEN [marge_reconnue_ht] END) / SUM(IF [annee] = [Parameters].[Parameter 1] THEN [ca_ht_reconnu] END)' />
            </column>
            <column caption='Taux de marge brute N-1' datatype='real' name='[Calculation_39740010]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [marge_reconnue_ht] END) / SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [ca_ht_reconnu] END)' />
            </column>
            <column caption='Taux de marge brute écart (pt)' datatype='real' name='[Calculation_39740011]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_39740009] - [Calculation_39740010]) * 100' />
            </column>
            <column caption='Taux de marge brute statut' datatype='string' name='[Calculation_39740012]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_39740011]) THEN &quot;Sans comparaison&quot; ELSEIF ABS([Calculation_39740011]) &lt; 0.5 THEN &quot;Stable&quot; ELSEIF [Calculation_39740011] * (1) &gt; 0 THEN &quot;Favorable&quot; ELSE &quot;Défavorable&quot; END' />
            </column>
            <column caption='Taux de marge brute valeur (texte)' datatype='string' name='[Calculation_39740013]' role='measure' type='nominal'>
              <calculation class='tableau' formula='REPLACE(STR(ROUND(([Calculation_39740009])*100,2)),&quot;.&quot;,&quot;,&quot;) + &quot; %&quot;' />
            </column>
            <column caption='Taux de marge brute évolution (texte)' datatype='string' name='[Calculation_39740014]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_39740011]) THEN &quot;Pas d&apos;année précédente&quot; ELSEIF ROUND([Calculation_39740011],2) = 0 THEN &quot;= 0 pt vs &quot; + STR([Parameters].[Parameter 1]-1) ELSE (IF ROUND([Calculation_39740011],2) &gt; 0 THEN &quot;▲ +&quot; ELSE &quot;▼ &quot; END) + REPLACE(STR(ROUND([Calculation_39740011],2)),&quot;.&quot;,&quot;,&quot;) + &quot; pt vs &quot; + STR([Parameters].[Parameter 1]-1) END' />
            </column>
            <column caption='Année' datatype='integer' name='[annee]' role='dimension' type='ordinal' />
            <column caption='CA HT reconnu' datatype='real' default-format='n#,##0' name='[ca_ht_reconnu]' role='measure' type='quantitative' />
            <column caption='Marge reconnue HT' datatype='real' default-format='n#,##0' name='[marge_reconnue_ht]' role='measure' type='quantitative' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column caption='Région' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_39740012]' derivation='User' name='[usr:Calculation_39740012:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_39740013]' derivation='User' name='[usr:Calculation_39740013:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_39740014]' derivation='User' name='[usr:Calculation_39740014:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <slices>
            <column>[federated.tunishop0direction01].[none:region:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <color column='[federated.tunishop0direction01].[usr:Calculation_39740012:nk]' />
              <text column='[federated.tunishop0direction01].[usr:Calculation_39740013:nk]' />
              <text column='[federated.tunishop0direction01].[usr:Calculation_39740014:nk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run bold='true' fontsize='15'><![CDATA[<[federated.tunishop0direction01].[usr:Calculation_39740013:nk]>]]></run>
