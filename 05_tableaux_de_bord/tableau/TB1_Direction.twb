    <worksheet name='D-K01 CA reconnu TTC'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1f4e79' fontsize='9'>CA reconnu TTC</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='TuniShop Direction (tab.v_direction)' name='federated.tunishop0direction01' />
            <datasource caption='Paramètres' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Année analysée' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2025'>
              <calculation class='tableau' formula='2025' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.tunishop0direction01'>
            <column caption='CA reconnu TTC N' datatype='real' name='[Calculation_39740003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [annee] = [Parameters].[Parameter 1] THEN [ca_reconnu_ttc] END)' />
            </column>
            <column caption='CA reconnu TTC N-1' datatype='real' name='[Calculation_39740004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [ca_reconnu_ttc] END)' />
            </column>
            <column caption='CA reconnu TTC évolution' datatype='real' name='[Calculation_39740005]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_39740004] = 0 THEN NULL ELSE ([Calculation_39740003] - [Calculation_39740004]) / [Calculation_39740004] END' />
            </column>
            <column caption='CA reconnu TTC statut' datatype='string' name='[Calculation_39740006]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_39740005]) THEN &quot;Sans comparaison&quot; ELSEIF ABS([Calculation_39740005]) &lt; 0.02 THEN &quot;Stable&quot; ELSEIF [Calculation_39740005] * (1) &gt; 0 THEN &quot;Favorable&quot; ELSE &quot;Défavorable&quot; END' />
            </column>
            <column caption='CA reconnu TTC valeur (texte)' datatype='string' name='[Calculation_39740007]' role='measure' type='nominal'>
              <calculation class='tableau' formula='REPLACE(STR(ROUND(([Calculation_39740003])/1000000,2)),&quot;.&quot;,&quot;,&quot;) + &quot; M TND&quot;' />
            </column>
            <column caption='CA reconnu TTC évolution (texte)' datatype='string' name='[Calculation_39740008]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_39740005]) THEN &quot;Pas d&apos;année précédente&quot; ELSEIF ROUND([Calculation_39740005]*100,1) = 0 THEN &quot;= 0 % vs &quot; + STR([Parameters].[Parameter 1]-1) ELSE (IF ROUND([Calculation_39740005]*100,1) &gt; 0 THEN &quot;▲ +&quot; ELSE &quot;▼ &quot; END) + REPLACE(STR(ROUND([Calculation_39740005]*100,1)),&quot;.&quot;,&quot;,&quot;) + &quot; % vs &quot; + STR([Parameters].[Parameter 1]-1) END' />
            </column>
            <column caption='Année' datatype='integer' name='[annee]' role='dimension' type='ordinal' />
            <column caption='CA reconnu TTC' datatype='real' default-format='n#,##0' name='[ca_reconnu_ttc]' role='measure' type='quantitative' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column caption='Région' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_39740006]' derivation='User' name='[usr:Calculation_39740006:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_39740007]' derivation='User' name='[usr:Calculation_39740007:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_39740008]' derivation='User' name='[usr:Calculation_39740008:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <slices>
            <column>[federated.tunishop0direction01].[none:region:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <color column='[federated.tunishop0direction01].[usr:Calculation_39740006:nk]' />
              <text column='[federated.tunishop0direction01].[usr:Calculation_39740007:nk]' />
              <text column='[federated.tunishop0direction01].[usr:Calculation_39740008:nk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run bold='true' fontsize='15'><![CDATA[<[federated.tunishop0direction01].[usr:Calculation_39740007:nk]>]]></run>
                <run>Æ&#10;</run>
                <run fontsize='9'><![CDATA[<[federated.tunishop0direction01].[usr:Calculation_39740008:nk]>]]></run>
              </formatted-text>
            </customized-label>
            <style>
