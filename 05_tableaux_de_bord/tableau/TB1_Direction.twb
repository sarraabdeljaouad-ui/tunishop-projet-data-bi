        <calculation class='tableau' formula='REPLACE(STR(ROUND([Calculation_39740063],3)),&quot;.&quot;,&quot;,&quot;)' />
      </column>
      <column caption='Note moyenne évolution (texte)' datatype='string' name='[Calculation_39740068]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_39740065]) THEN &quot;Pas d&apos;année précédente&quot; ELSEIF ROUND([Calculation_39740065]*100,1) = 0 THEN &quot;= 0 % vs &quot; + STR([Parameters].[Parameter 1]-1) ELSE (IF ROUND([Calculation_39740065]*100,1) &gt; 0 THEN &quot;▲ +&quot; ELSE &quot;▼ &quot; END) + REPLACE(STR(ROUND([Calculation_39740065]*100,1)),&quot;.&quot;,&quot;,&quot;) + &quot; % vs &quot; + STR([Parameters].[Parameter 1]-1) END' />
      </column>
      <column caption='Année N' datatype='boolean' name='[Calculation_39740069]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[annee] = [Parameters].[Parameter 1]' />
      </column>
      <column caption='Année N ou N-1' datatype='boolean' name='[Calculation_39740070]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[annee] = [Parameters].[Parameter 1] OR [annee] = [Parameters].[Parameter 1] - 1' />
      </column>
      <column caption='Années 2023-2025' datatype='boolean' name='[Calculation_39740071]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[annee] &gt;= 2023 AND [annee] &lt;= 2025' />
      </column>
      <column caption='Catégorie renseignée' datatype='boolean' name='[Calculation_39740072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([categorie])' />
      </column>
      <column caption='Région renseignée' datatype='boolean' name='[Calculation_39740073]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([region])' />
      </column>
      <column caption='Taux de marge' datatype='real' default-format='p0.0%' name='[Calculation_39740074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([marge_reconnue_ht]) / SUM([ca_ht_reconnu])' />
      </column>
      <column caption='OTD' datatype='real' default-format='p0.0%' name='[Calculation_39740075]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([nb_livrees_a_temps]) / SUM([nb_livrees])' />
      </column>
      <column caption='Taux de rupture (année)' datatype='real' default-format='p0.0%' name='[Calculation_39740076]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN({FIXED [annee] : SUM([nb_ruptures]) / SUM([nb_inventaires])})' />
      </column>
      <column caption='Achats HT (année)' datatype='real' default-format='n#,##0' name='[Calculation_39740077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN({FIXED [annee] : SUM([montant_achat_ht])})' />
      </column>
      <column caption='ROAS (année)' datatype='real' default-format='n0.000' name='[Calculation_39740078]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN({FIXED [annee] : SUM([ca_attribue_ttc]) / SUM([depense_ht])})' />
      </column>
      <column caption='Note moyenne (année)' datatype='real' default-format='n0.000' name='[Calculation_39740079]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN({FIXED [annee] : SUM([somme_notes]) / SUM([nb_avis_notes])})' />
      </column>
      <column caption='Valeur du stock fin d&apos;année' datatype='real' default-format='n#,##0' name='[Calculation_39740080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN({FIXED [annee] : SUM([Calculation_39740002])})' />
      </column>
