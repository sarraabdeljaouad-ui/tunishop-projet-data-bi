            <column caption='Note moyenne évolution' datatype='real' name='[Calculation_39740065]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_39740064] = 0 THEN NULL ELSE ([Calculation_39740063] - [Calculation_39740064]) / [Calculation_39740064] END' />
            </column>
            <column caption='Note moyenne statut' datatype='string' name='[Calculation_39740066]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_39740065]) THEN &quot;Sans comparaison&quot; ELSEIF ABS([Calculation_39740065]) &lt; 0.02 THEN &quot;Stable&quot; ELSEIF [Calculation_39740065] * (1) &gt; 0 THEN &quot;Favorable&quot; ELSE &quot;Défavorable&quot; END' />
