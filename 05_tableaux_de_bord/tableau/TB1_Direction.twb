    <worksheet name='D-T2 OTD'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1f4e79' fontsize='9'>Livraisons à temps (OTD)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='TuniShop Direction (tab.v_direction)' name='federated.tunishop0direction01' />
          </datasources>
          <datasource-dependencies datasource='federated.tunishop0direction01'>
            <column caption='Années 2023-2025' datatype='boolean' name='[Calculation_39740071]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[annee] &gt;= 2023 AND [annee] &lt;= 2025' />
            </column>
            <column caption='OTD' datatype='real' default-format='p0.0%' name='[Calculation_39740075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([nb_livrees_a_temps]) / SUM([nb_livrees])' />
            </column>
            <column caption='Année' datatype='integer' name='[annee]' role='dimension' type='ordinal' />
            <column caption='Nb livrees' datatype='integer' default-format='n#,##0' name='[nb_livrees]' role='measure' type='quantitative' />
            <column caption='Nb livrees a temps' datatype='integer' default-format='n#,##0' name='[nb_livrees_a_temps]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_39740071]' derivation='None' name='[none:Calculation_39740071:nk]' pivot='key' type='nominal' />
