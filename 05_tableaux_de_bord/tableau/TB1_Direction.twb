              <text column='[federated.tunishop0direction01].[usr:Calculation_39740055:nk]' />
              <text column='[federated.tunishop0direction01].[usr:Calculation_39740056:nk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run bold='true' fontsize='15'><![CDATA[<[federated.tunishop0direction01].[usr:Calculation_39740055:nk]>]]></run>
