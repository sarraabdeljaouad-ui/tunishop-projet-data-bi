            <datasource caption='Paramètres' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Année analysée' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2025'>
              <calculation class='tableau' formula='2025' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.tunishop0direction01'>
            <column caption='Achats HT N' datatype='real' name='[Calculation_39740045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN({FIXED : SUM(IF [annee] = [Parameters].[Parameter 1] THEN [montant_achat_ht] END)})' />
            </column>
            <column caption='Achats HT N-1' datatype='real' name='[Calculation_39740046]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN({FIXED : SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [montant_achat_ht] END)})' />
            </column>
            <column caption='Achats HT évolution' datatype='real' name='[Calculation_39740047]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_39740046] = 0 THEN NULL ELSE ([Calculation_39740045] - [Calculation_39740046]) / [Calculation_39740046] END' />
            </column>
            <column caption='Achats HT statut' datatype='string' name='[Calculation_39740048]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_39740047]) THEN &quot;Sans comparaison&quot; ELSE &quot;Neutre&quot; END' />
            </column>
            <column caption='Achats HT valeur (texte)' datatype='string' name='[Calculation_39740049]' role='measure' type='nominal'>
              <calculation class='tableau' formula='REPLACE(STR(ROUND(([Calculation_39740045])/1000000,2)),&quot;.&quot;,&quot;,&quot;) + &quot; M TND&quot;' />
            </column>
            <column caption='Achats HT évolution (texte)' datatype='string' name='[Calculation_39740050]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_39740047]) THEN &quot;Pas d&apos;année précédente&quot; ELSEIF ROUND([Calculation_39740047]*100,1) = 0 THEN &quot;= 0 % vs &quot; + STR([Parameters].[Parameter 1]-1) ELSE (IF ROUND([Calculation_39740047]*100,1) &gt; 0 THEN &quot;▲ +&quot; ELSE &quot;▼ &quot; END) + REPLACE(STR(ROUND([Calculation_39740047]*100,1)),&quot;.&quot;,&quot;,&quot;) + &quot; % vs &quot; + STR([Parameters].[Parameter 1]-1) END' />
            </column>
