    <worksheet name='D-K06 Valeur du stock HT'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1f4e79' fontsize='9'>Valeur du stock HT</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='TuniShop Direction (tab.v_direction)' name='federated.tunishop0direction01' />
            <datasource caption='Paramètres' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Année analysée' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2025'>
              <calculation class='tableau' formula='2025' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.tunishop0direction01'>
            <column caption='Date fin de stock (année)' datatype='date' name='[Calculation_39740001]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [annee] : MAX(IF [source] = &apos;Stock&apos; THEN [date_jour] END)}' />
            </column>
            <column caption='Valeur stock fin d&apos;année (ligne)' datatype='real' name='[Calculation_39740002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [source] = &apos;Stock&apos; AND [date_jour] = [Calculation_39740001] THEN [valeur_stock_ht] END' />
            </column>
            <column caption='Valeur du stock HT N' datatype='real' name='[Calculation_39740033]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN({FIXED : SUM(IF [annee] = [Parameters].[Parameter 1] THEN [Calculation_39740002] END)})' />
            </column>
            <column caption='Valeur du stock HT N-1' datatype='real' name='[Calculation_39740034]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN({FIXED : SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [Calculation_39740002] END)})' />
            </column>
            <column caption='Valeur du stock HT évolution' datatype='real' name='[Calculation_39740035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_39740034] = 0 THEN NULL ELSE ([Calculation_39740033] - [Calculation_39740034]) / [Calculation_39740034] END' />
            </column>
            <column caption='Valeur du stock HT statut' datatype='string' name='[Calculation_39740036]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_39740035]) THEN &quot;Sans comparaison&quot; ELSE &quot;Neutre&quot; END' />
            </column>
            <column caption='Valeur du stock HT valeur (texte)' datatype='string' name='[Calculation_39740037]' role='measure' type='nominal'>
              <calculation class='tableau' formula='REPLACE(STR(ROUND(([Calculation_39740033])/1000000,2)),&quot;.&quot;,&quot;,&quot;) + &quot; M TND&quot;' />
            </column>
            <column caption='Valeur du stock HT évolution (texte)' datatype='string' name='[Calculation_39740038]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_39740035]) THEN &quot;Pas d&apos;année précédente&quot; ELSEIF ROUND([Calculation_39740035]*100,1) = 0 THEN &quot;= 0 % vs &quot; + STR([Parameters].[Parameter 1]-1) ELSE (IF ROUND([Calculation_39740035]*100,1) &gt; 0 THEN &quot;▲ +&quot; ELSE &quot;▼ &quot; END) + REPLACE(STR(ROUND([Calculation_39740035]*100,1)),&quot;.&quot;,&quot;,&quot;) + &quot; % vs &quot; + STR([Parameters].[Parameter 1]-1) END' />
            </column>
            <column caption='Année' datatype='integer' name='[annee]' role='dimension' type='ordinal' />
            <column caption='Date' datatype='date' name='[date_jour]' role='dimension' type='ordinal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column caption='Région' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column caption='Source' datatype='string' name='[source]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_39740036]' derivation='User' name='[usr:Calculation_39740036:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_39740037]' derivation='User' name='[usr:Calculation_39740037:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_39740038]' derivation='User' name='[usr:Calculation_39740038:nk]' pivot='key' type='nominal' />
            <column caption='Valeur stock HT' datatype='real' default-format='n#,##0' name='[valeur_stock_ht]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <slices>
            <column>[federated.tunishop0direction01].[none:region:nk]</column>
