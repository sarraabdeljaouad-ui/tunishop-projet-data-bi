    <worksheet name='D-K09 Taux de service fournisseur'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1f4e79' fontsize='9'>Service fournisseur</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='TuniShop Direction (tab.v_direction)' name='federated.tunishop0direction01' />
            <datasource caption='Paramètres' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Année analysée' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2025'>
              <calculation class='tableau' formula='2025' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.tunishop0direction01'>
            <column caption='Taux de service fournisseur N' datatype='real' name='[Calculation_39740051]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN({FIXED : SUM(IF [annee] = [Parameters].[Parameter 1] THEN [quantite_recue] END) / SUM(IF [annee] = [Parameters].[Parameter 1] THEN [quantite_commandee_recue] END)})' />
            </column>
            <column caption='Taux de service fournisseur N-1' datatype='real' name='[Calculation_39740052]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN({FIXED : SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [quantite_recue] END) / SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [quantite_commandee_recue] END)})' />
            </column>
            <column caption='Taux de service fournisseur écart (pt)' datatype='real' name='[Calculation_39740053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_39740051] - [Calculation_39740052]) * 100' />
            </column>
            <column caption='Taux de service fournisseur statut' datatype='string' name='[Calculation_39740054]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_39740053]) THEN &quot;Sans comparaison&quot; ELSEIF ABS([Calculation_39740053]) &lt; 0.5 THEN &quot;Stable&quot; ELSEIF [Calculation_39740053] * (1) &gt; 0 THEN &quot;Favorable&quot; ELSE &quot;Défavorable&quot; END' />
            </column>
            <column caption='Taux de service fournisseur valeur (texte)' datatype='string' name='[Calculation_39740055]' role='measure' type='nominal'>
              <calculation class='tableau' formula='REPLACE(STR(ROUND(([Calculation_39740051])*100,2)),&quot;.&quot;,&quot;,&quot;) + &quot; %&quot;' />
            </column>
            <column caption='Taux de service fournisseur évolution (texte)' datatype='string' name='[Calculation_39740056]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_39740053]) THEN &quot;Pas d&apos;année précédente&quot; ELSEIF ROUND([Calculation_39740053],2) = 0 THEN &quot;= 0 pt vs &quot; + STR([Parameters].[Parameter 1]-1) ELSE (IF ROUND([Calculation_39740053],2) &gt; 0 THEN &quot;▲ +&quot; ELSE &quot;▼ &quot; END) + REPLACE(STR(ROUND([Calculation_39740053],2)),&quot;.&quot;,&quot;,&quot;) + &quot; pt vs &quot; + STR([Parameters].[Parameter 1]-1) END' />
            </column>
            <column caption='Année' datatype='integer' name='[annee]' role='dimension' type='ordinal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column caption='Quantite commandee recue' datatype='integer' default-format='n#,##0' name='[quantite_commandee_recue]' role='measure' type='quantitative' />
            <column caption='Quantite recue' datatype='integer' default-format='n#,##0' name='[quantite_recue]' role='measure' type='quantitative' />
            <column caption='Région' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_39740054]' derivation='User' name='[usr:Calculation_39740054:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_39740055]' derivation='User' name='[usr:Calculation_39740055:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_39740056]' derivation='User' name='[usr:Calculation_39740056:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <slices>
            <column>[federated.tunishop0direction01].[none:region:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
