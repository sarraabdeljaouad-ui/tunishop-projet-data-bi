              <calculation class='tableau' formula='IF ISNULL([Calculation_39740023]) THEN &quot;Sans comparaison&quot; ELSEIF ABS([Calculation_39740023]) &lt; 0.02 THEN &quot;Stable&quot; ELSEIF [Calculation_39740023] * (1) &gt; 0 THEN &quot;Favorable&quot; ELSE &quot;Défavorable&quot; END' />
            </column>
            <column caption='Clients actifs valeur (texte)' datatype='string' name='[Calculation_39740025]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ROUND([Calculation_39740021],0) &gt;= 1000 THEN STR(INT(ROUND([Calculation_39740021],0)/1000)) + &quot; &quot; + RIGHT(&quot;00&quot; + STR(INT(ROUND([Calculation_39740021],0)) % 1000), 3) ELSE STR(INT(ROUND([Calculation_39740021],0))) END' />
            </column>
            <column caption='Clients actifs évolution (texte)' datatype='string' name='[Calculation_39740026]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_39740023]) THEN &quot;Pas d&apos;année précédente&quot; ELSEIF ROUND([Calculation_39740023]*100,1) = 0 THEN &quot;= 0 % vs &quot; + STR([Parameters].[Parameter 1]-1) ELSE (IF ROUND([Calculation_39740023]*100,1) &gt; 0 THEN &quot;▲ +&quot; ELSE &quot;▼ &quot; END) + REPLACE(STR(ROUND([Calculation_39740023]*100,1)),&quot;.&quot;,&quot;,&quot;) + &quot; % vs &quot; + STR([Parameters].[Parameter 1]-1) END' />
            </column>
            <column caption='Année' datatype='integer' name='[annee]' role='dimension' type='ordinal' />
            <column caption='Client actif (clé)' datatype='integer' name='[client_actif_sk]' role='dimension' type='ordinal' />
