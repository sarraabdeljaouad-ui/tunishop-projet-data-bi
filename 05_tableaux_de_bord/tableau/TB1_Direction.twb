    <worksheet name='D-K07 Taux de rupture de stock'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1f4e79' fontsize='9'>Rupture de stock</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='TuniShop Direction (tab.v_direction)' name='federated.tunishop0direction01' />
            <datasource caption='Paramètres' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Année analysée' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2025'>
              <calculation class='tableau' formula='2025' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.tunishop0direction01'>
            <column caption='Taux de rupture de stock N' datatype='real' name='[Calculation_39740039]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN({FIXED : SUM(IF [annee] = [Parameters].[Parameter 1] THEN [nb_ruptures] END) / SUM(IF [annee] = [Parameters].[Parameter 1] THEN [nb_inventaires] END)})' />
            </column>
            <column caption='Taux de rupture de stock N-1' datatype='real' name='[Calculation_39740040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN({FIXED : SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [nb_ruptures] END) / SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [nb_inventaires] END)})' />
            </column>
            <column caption='Taux de rupture de stock écart (pt)' datatype='real' name='[Calculation_39740041]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_39740039] - [Calculation_39740040]) * 100' />
            </column>
            <column caption='Taux de rupture de stock statut' datatype='string' name='[Calculation_39740042]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_39740041]) THEN &quot;Sans comparaison&quot; ELSEIF ABS([Calculation_39740041]) &lt; 0.5 THEN &quot;Stable&quot; ELSEIF [Calculation_39740041] * (-1) &gt; 0 THEN &quot;Favorable&quot; ELSE &quot;Défavorable&quot; END' />
            </column>
            <column caption='Taux de rupture de stock valeur (texte)' datatype='string' name='[Calculation_39740043]' role='measure' type='nominal'>
              <calculation class='tableau' formula='REPLACE(STR(ROUND(([Calculation_39740039])*100,2)),&quot;.&quot;,&quot;,&quot;) + &quot; %&quot;' />
            </column>
            <column caption='Taux de rupture de stock évolution (texte)' datatype='string' name='[Calculation_39740044]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_39740041]) THEN &quot;Pas d&apos;année précédente&quot; ELSEIF ROUND([Calculation_39740041],2) = 0 THEN &quot;= 0 pt vs &quot; + STR([Parameters].[Parameter 1]-1) ELSE (IF ROUND([Calculation_39740041],2) &gt; 0 THEN &quot;▲ +&quot; ELSE &quot;▼ &quot; END) + REPLACE(STR(ROUND([Calculation_39740041],2)),&quot;.&quot;,&quot;,&quot;) + &quot; pt vs &quot; + STR([Parameters].[Parameter 1]-1) END' />
            </column>
            <column caption='Année' datatype='integer' name='[annee]' role='dimension' type='ordinal' />
            <column caption='Nb inventaires' datatype='integer' default-format='n#,##0' name='[nb_inventaires]' role='measure' type='quantitative' />
            <column caption='Nb ruptures' datatype='integer' default-format='n#,##0' name='[nb_ruptures]' role='measure' type='quantitative' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column caption='Région' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_39740042]' derivation='User' name='[usr:Calculation_39740042:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_39740043]' derivation='User' name='[usr:Calculation_39740043:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_39740044]' derivation='User' name='[usr:Calculation_39740044:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <slices>
            <column>[federated.tunishop0direction01].[none:region:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
