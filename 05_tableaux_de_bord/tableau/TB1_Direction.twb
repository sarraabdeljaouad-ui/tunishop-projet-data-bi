    <worksheet name='D-K05 ROAS'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1f4e79' fontsize='9'>ROAS</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='TuniShop Direction (tab.v_direction)' name='federated.tunishop0direction01' />
            <datasource caption='Paramètres' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Année analysée' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2025'>
              <calculation class='tableau' formula='2025' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.tunishop0direction01'>
            <column caption='ROAS N' datatype='real' name='[Calculation_39740027]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN({FIXED : SUM(IF [annee] = [Parameters].[Parameter 1] THEN [ca_attribue_ttc] END) / SUM(IF [annee] = [Parameters].[Parameter 1] THEN [depense_ht] END)})' />
            </column>
            <column caption='ROAS N-1' datatype='real' name='[Calculation_39740028]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN({FIXED : SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [ca_attribue_ttc] END) / SUM(IF [annee] = ([Parameters].[Parameter 1]-1) THEN [depense_ht] END)})' />
            </column>
            <column caption='ROAS évolution' datatype='real' name='[Calculation_39740029]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_39740028] = 0 THEN NULL ELSE ([Calculation_39740027] - [Calculation_39740028]) / [Calculation_39740028] END' />
            </column>
            <column caption='ROAS statut' datatype='string' name='[Calculation_39740030]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_39740029]) THEN &quot;Sans comparaison&quot; ELSEIF ABS([Calculation_39740029]) &lt; 0.02 THEN &quot;Stable&quot; ELSEIF [Calculation_39740029] * (1) &gt; 0 THEN &quot;Favorable&quot; ELSE &quot;Défavorable&quot; END' />
            </column>
            <column caption='ROAS valeur (texte)' datatype='string' name='[Calculation_39740031]' role='measure' type='nominal'>
              <calculation class='tableau' formula='REPLACE(STR(ROUND([Calculation_39740027],3)),&quot;.&quot;,&quot;,&quot;)' />
            </column>
            <column caption='ROAS évolution (texte)' datatype='string' name='[Calculation_39740032]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_39740029]) THEN &quot;Pas d&apos;année précédente&quot; ELSEIF ROUND([Calculation_39740029]*100,1) = 0 THEN &quot;= 0 % vs &quot; + STR([Parameters].[Parameter 1]-1) ELSE (IF ROUND([Calculation_39740029]*100,1) &gt; 0 THEN &quot;▲ +&quot; ELSE &quot;▼ &quot; END) + REPLACE(STR(ROUND([Calculation_39740029]*100,1)),&quot;.&quot;,&quot;,&quot;) + &quot; % vs &quot; + STR([Parameters].[Parameter 1]-1) END' />
            </column>
            <column caption='Année' datatype='integer' name='[annee]' role='dimension' type='ordinal' />
            <column caption='CA attribue TTC' datatype='real' default-format='n#,##0' name='[ca_attribue_ttc]' role='measure' type='quantitative' />
            <column caption='Depense HT' datatype='real' default-format='n#,##0' name='[depense_ht]' role='measure' type='quantitative' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column caption='Région' datatype='string' name='[region]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_39740030]' derivation='User' name='[usr:Calculation_39740030:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_39740031]' derivation='User' name='[usr:Calculation_39740031:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_39740032]' derivation='User' name='[usr:Calculation_39740032:nk]' pivot='key' type='nominal' />
