  <dashboards>
    <dashboard name='Direction - Synthèse'>
      <style />
      <size maxheight='720' maxwidth='1280' minheight='720' minwidth='1280' />
      <datasources>
        <datasource caption='Paramètres' name='Parameters' />
        <datasource caption='TuniShop Direction (tab.v_direction)' name='federated.tunishop0direction01' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Année analysée' datatype='integer' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2025'>
          <calculation class='tableau' formula='2025' />
          <members>
            <member value='2023' />
            <member value='2024' />
            <member value='2025' />
          </members>
        </column>
      </datasource-dependencies>
      <datasource-dependencies datasource='federated.tunishop0direction01'>
        <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
        <column caption='Région' datatype='string' name='[region]' role='dimension' type='nominal' />
      </datasource-dependencies>
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone floating='true' h='9444' id='3' type-v2='text' w='100000' x='0' y='0'>
            <formatted-text>
              <run bold='true' fontcolor='#ffffff' fontsize='18'>TB-1 Direction · Synthèse</run>
              <run>Æ&#10;</run>
              <run fontcolor='#d6e4f0' fontsize='9'>TuniShop · source TuniShop_DWH (vues tab) · couleurs : vert mieux que l&apos;année précédente, gris stable ou neutre, rouge moins bien</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
